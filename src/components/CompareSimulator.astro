---
// 商談化シミュレーター：現在の月間広告費・CVR・平均単価から、
// CVR がN%改善した場合の月間商談数差分を概算で表示する。
---
<div class="sim card">
  <h3 style="margin-top:0; font-size:18px">商談化シミュレーション</h3>
  <p class="muted" style="font-size:13.5px; margin:0 0 16px">あくまで概算です。最終的な提案は、事業の状態を聞いたうえで個別に組みます。</p>

  <div class="sim__inputs" id="simBox">
    <div class="form-field">
      <label>月間広告費（万円）</label>
      <input type="number" id="simSpend" min="0" step="10" value="300" />
    </div>
    <div class="form-field">
      <label>現在の商談化率（%）</label>
      <input type="number" id="simCvr" min="0" max="100" step="0.1" value="2" />
    </div>
    <div class="form-field">
      <label>平均商談単価（万円）</label>
      <input type="number" id="simAcv" min="0" step="10" value="200" />
    </div>
  </div>

  <div class="sim__result" id="simResult">
    <div class="sim__line">
      <span class="sim__k">現状の推定商談数</span>
      <span class="sim__v" id="simCur">—</span>
    </div>
    <div class="sim__line sim__line--accent">
      <span class="sim__k">みんどり後（商談化率 +50% 改善した場合）</span>
      <span class="sim__v" id="simNew">—</span>
    </div>
    <div class="sim__line sim__line--note">
      <span class="sim__k">想定される追加商談額／月</span>
      <span class="sim__v" id="simGain">—</span>
    </div>
  </div>

  <p class="muted" style="font-size:12px; margin:14px 0 0">
    ※ 改善率は事業・商材・既存ページ状態によって大きく異なります。成果を保証するものではありません。
  </p>
</div>

<script is:inline>
  (function () {
    var box = document.getElementById('simBox');
    if (!box) return;
    var spend = document.getElementById('simSpend');
    var cvr = document.getElementById('simCvr');
    var acv = document.getElementById('simAcv');
    var oCur = document.getElementById('simCur');
    var oNew = document.getElementById('simNew');
    var oGain = document.getElementById('simGain');
    var fmt = function (n) { return n.toLocaleString('ja-JP', { maximumFractionDigits: 1 }); };
    function recalc() {
      var s = +spend.value || 0; // 万円/月
      var c = (+cvr.value || 0) / 100;
      var a = +acv.value || 0; // 万円
      // 仮定: 広告費の 5% をリード獲得効率と置く（クリック→リードの簡易係数）
      var leads = s * 0.05;
      var meetingsNow = leads * c;
      var meetingsNew = leads * c * 1.5;
      var gain = (meetingsNew - meetingsNow) * a;
      oCur.textContent = fmt(meetingsNow) + ' 件';
      oNew.textContent = fmt(meetingsNew) + ' 件';
      oGain.textContent = fmt(gain) + ' 万円';
    }
    [spend, cvr, acv].forEach(function (i) { i.addEventListener('input', recalc); });
    recalc();
  })();
</script>

<style is:inline>
  .sim__inputs { display: grid; grid-template-columns: 1fr; gap: 12px; }
  @media (min-width: 720px) { .sim__inputs { grid-template-columns: repeat(3, 1fr); } }
  .sim__result {
    margin-top: 20px; padding: 18px 20px;
    background: var(--paper-2); border-radius: 10px;
  }
  .sim__line {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 8px 0; border-bottom: 1px dashed var(--line);
    gap: 14px; flex-wrap: wrap;
  }
  .sim__line:last-child { border-bottom: 0; }
  .sim__line--accent .sim__v { color: var(--accent-deep); font-weight: 800; font-size: 18px; }
  .sim__line--note .sim__v { color: var(--warn); font-weight: 800; font-size: 18px; }
  .sim__k { font-size: 13.5px; color: var(--muted); }
  .sim__v { font-size: 15px; color: var(--ink); font-weight: 700; }
</style>
