---
interface Item { title: string; body: string; }
interface Props {
  before: Item;
  after: Item;
  beforeLabel?: string;
  afterLabel?: string;
}
const { before, after, beforeLabel = 'Before', afterLabel = 'After' } = Astro.props as Props;
---
<div class="ba">
  <div class="ba__item ba__item--before">
    <div class="ba__label ba__label--before">{beforeLabel}</div>
    <h4 class="ba__title">{before.title}</h4>
    <p class="ba__body">{before.body}</p>
  </div>
  <div class="ba__arrow" aria-hidden="true">
    <svg viewBox="0 0 32 16" fill="none">
      <path d="M 2 8 L 28 8 M 22 3 L 28 8 L 22 13" stroke="#168a6a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
  <div class="ba__item ba__item--after">
    <div class="ba__label ba__label--after">{afterLabel}</div>
    <h4 class="ba__title">{after.title}</h4>
    <p class="ba__body">{after.body}</p>
  </div>
</div>

<style is:inline>
  .ba {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    align-items: stretch;
  }
  .ba__item {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 20px;
    box-shadow: var(--shadow-sm);
  }
  .ba__item--before { border-left: 4px solid var(--warn); }
  .ba__item--after { border-left: 4px solid var(--accent); }
  .ba__label {
    display: inline-block;
    font-size: 11px; letter-spacing: 0.16em;
    font-weight: 700; text-transform: uppercase;
    padding: 4px 10px; border-radius: 4px;
    margin-bottom: 12px;
  }
  .ba__label--before { background: rgba(199,125,49,0.10); color: var(--warn); }
  .ba__label--after { background: rgba(22,138,106,0.10); color: var(--accent-deep); }
  .ba__title { font-size: 16px; margin: 0 0 8px; }
  .ba__body { font-size: 14px; color: var(--muted); margin: 0; line-height: 1.85; }
  .ba__arrow {
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    transform: rotate(90deg);
  }
  .ba__arrow svg { width: 28px; height: 14px; }
  @media (min-width: 720px) {
    .ba { grid-template-columns: 1fr auto 1fr; gap: 18px; }
    .ba__arrow { transform: none; }
  }
</style>
