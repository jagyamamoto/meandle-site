---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'ghost-light' | 'warn';
  size?: 'md' | 'lg';
}
const { href, variant = 'primary', size = 'md' } = Astro.props as Props;
const klass = ['btn',
  size === 'lg' ? 'btn--lg' : '',
  variant === 'ghost' ? 'btn--ghost' : '',
  variant === 'ghost-light' ? 'btn--ghost-light' : '',
  variant === 'warn' ? 'btn--warn' : '',
].filter(Boolean).join(' ');
---
<a href={href} class={klass}><slot /></a>
