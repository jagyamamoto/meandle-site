---
import nav from '../data/navigation.json';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__cols">
      <div class="site-footer__brand">
        <h3>Meandle<span class="dot">.</span></h3>
        <p>広告費を増やす前に、売るべき意味を整える。</p>
        <p class="note">
          Meandleは、<a href="https://jagproject.com/" rel="noopener" target="_blank">Jag Yamamoto / Jag Project</a> が開発・監修するB2B意味設計サービスです。
        </p>
      </div>
      <div class="site-footer__col">
        <h4>サービス</h4>
        <ul>{nav.footer.services.map((it) => <li><a href={it.href}>{it.label}</a></li>)}</ul>
      </div>
      <div class="site-footer__col">
        <h4>もっと知る</h4>
        <ul>{nav.footer.more.map((it) => (
          <li>
            {it.external
              ? <a href={it.href} rel="noopener" target="_blank">{it.label} ↗</a>
              : <a href={it.href}>{it.label}</a>}
          </li>
        ))}</ul>
      </div>
    </div>
    <div class="site-footer__legal">
      <span>© {year} Jag Project. All rights reserved.</span>
      <span>meandle.jp</span>
    </div>
  </div>
</footer>
