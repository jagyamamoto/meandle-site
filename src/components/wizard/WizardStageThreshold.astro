---
// 段階の敷居 — 各段階ページ冒頭に置く定型2文。
// 「この段階で作るもの」「前の段階から受け取ったもの」を毎回同じ言い回しで示す。
interface Props {
  makes: string;
  receivedFrom?: string;
}

const { makes, receivedFrom } = Astro.props;
---
<p class="wp-threshold">
  <span class="wp-threshold__line">
    この段階で作るもの: <strong>{makes}</strong>
  </span>
  {receivedFrom && (
    <span class="wp-threshold__line">
      前の段階から受け取ったもの: <strong>{receivedFrom}</strong>
    </span>
  )}
</p>
