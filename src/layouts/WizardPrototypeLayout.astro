---
// Meandle Wizard Prototype layout — used for all agency-side prototype pages.
// Does NOT extend BaseLayout to keep isolation from marketing site.

import '../styles/wizard-prototype.css';

interface Props {
  title: string;
  description?: string;
  stage?: 'materials' | 'evidence' | 'meaning' | 'preflight' | 'approval' | 'observation' | 'publication' | 'results' | 'report' | null;
}

const {
  title,
  description = 'Meandle Wizard Partner v1 — 操作デモ',
  stage = null,
} = Astro.props;

const railLinks = [
  { href: '/wizard/', label: '今日の作業' },
  { href: '/wizard/campaign/demo/materials/', label: '案件（RelayOne デモ）' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Meandle Wizard</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="wizard-prototype">
    <a class="wp-skip" href="#wp-main">本文へスキップ</a>

    <div class="wp-shell">
      <nav class="wp-rail" aria-label="Meandle Wizard ナビゲーション">
        <div class="wp-rail__brand">
          MEANDLE WIZARD
          <small>PROTOTYPE v1</small>
        </div>
        {railLinks.map((link) => (
          <a
            class="wp-rail__link"
            href={link.href}
            aria-current={Astro.url.pathname.startsWith(link.href) && link.href !== '/wizard/' ? 'page' : (Astro.url.pathname === link.href ? 'page' : undefined)}
          >
            {link.label}
          </a>
        ))}
        <div class="wp-rail__section">
          代理店ワークスペース<br />
          デモ代理店（プロトタイプ）
        </div>
      </nav>

      <main class="wp-main" id="wp-main">
        <div class="wp-demo-banner" role="status" aria-live="polite">
          <strong>操作デモ</strong>
          <span>架空のデータを使用しています。実在企業の資料や機密情報は入力しないでください。</span>
          <span class="wp-demo-banner__spacer"></span>
          <button type="button" class="wp-demo-banner__reset" data-wp-reset>
            デモを初期状態に戻す
          </button>
        </div>

        <slot name="header" />
        {stage && <slot name="stage" />}

        <div class="wp-content">
          <slot />
        </div>
      </main>
    </div>

    <script>
      import '../scripts/wizard-prototype.ts';
    </script>
  </body>
</html>
