---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;      // pathname (e.g. '/do-meandle/')
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;         // 'website' | 'article' | ...
  ogImage?: string;        // absolute or root-relative
  structuredData?: any[];  // array of JSON-LD objects (rendered as-is)
}

const SITE_URL = 'https://meandle.jp';
const {
  title = "広告費を増やす前に、AIと見込み客が拾える「売る意味」を整える｜Meandle",
  description = "Meandleは、複雑なB2B商材の「誰に・何を・何ではないか」を意味仕様にし、既存Web、PR、求人へ実装する高単価B2Bソリューションです。",
  canonical,
  ogTitle,
  ogDescription,
  ogType = 'website',
  ogImage,
  structuredData = [],
} = Astro.props;

const pageUrl = SITE_URL + (canonical || Astro.url.pathname);
const _ogTitle = ogTitle ?? title;
const _ogDesc  = ogDescription ?? description;
const _ogImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : SITE_URL + ogImage)
  : (SITE_URL + '/images/meandle-logo.png');
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={pageUrl}>
  <meta property="og:site_name" content="Meandle">
  <meta property="og:locale" content="ja_JP">
  <meta property="og:url" content={pageUrl}>
  <meta property="og:title" content={_ogTitle}>
  <meta property="og:description" content={_ogDesc}>
  <meta property="og:type" content={ogType}>
  <meta property="og:image" content={_ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={_ogTitle}>
  <meta name="twitter:description" content={_ogDesc}>
  <meta name="twitter:image" content={_ogImage}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="icon" href="/favicon.ico">
  {structuredData.map((data) => (
    <script type="application/ld+json" set:html={JSON.stringify(data)} />
  ))}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />

  <script is:inline>
  /* ═══════════════════════════════════════════════════════
     Site-wide Motion Orchestrator
     — enables progressive-enhancement animations
     — safe on every page (does nothing if no motion classes)
     ═══════════════════════════════════════════════════════ */
  (function () {
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;

    document.documentElement.classList.add('motion-init');

    // Formula build-in: stagger .tok tokens (if any)
    document.querySelectorAll('.motion-formula').forEach(function (container) {
      var toks = container.querySelectorAll('.tok');
      toks.forEach(function (el, i) {
        el.style.transitionDelay = (i * 0.045).toFixed(3) + 's';
      });
    });

    // Algo flow: stagger rect/text/line (if any)
    document.querySelectorAll('.motion-flow').forEach(function (container) {
      var rects = container.querySelectorAll('svg g > rect');
      var texts = container.querySelectorAll('svg g > text');
      var lines = container.querySelectorAll('svg g > line');
      rects.forEach(function (el, i) { el.style.transitionDelay = (i * 0.22).toFixed(3) + 's'; });
      texts.forEach(function (el, i) {
        var step = Math.floor(i / 2);
        el.style.transitionDelay = (step * 0.22 + 0.10).toFixed(3) + 's';
      });
      lines.forEach(function (el, i) {
        el.style.transitionDelay = ((i + 1) * 0.22 + 0.05).toFixed(3) + 's';
      });
    });

    // Generic stagger: children of .motion-stagger get sequential delay
    document.querySelectorAll('.motion-stagger').forEach(function (container) {
      var children = container.children;
      for (var i = 0; i < children.length; i++) {
        children[i].style.transitionDelay = (i * 0.10).toFixed(3) + 's';
      }
    });

    var inViewIO = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          inViewIO.unobserve(e.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });

    document.querySelectorAll('.motion-formula, .motion-flow, .motion-fade, .motion-stagger').forEach(function (el) {
      inViewIO.observe(el);
    });

    // Numeric counters
    function fmt(v, decimals) {
      // Use locale formatting for 4+ digit integer parts (adds thousands separator)
      try {
        return v.toLocaleString('en-US', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        });
      } catch (e) {
        return v.toFixed(decimals);
      }
    }
    function animateCounter(el) {
      var to = parseFloat(el.dataset.countTo);
      if (Number.isNaN(to)) return;
      var decimals = parseInt(el.dataset.decimals || '0', 10);
      var duration = parseInt(el.dataset.duration || '1200', 10);
      var suffix = el.dataset.suffix || '';
      var prefix = el.dataset.prefix || '';
      var start = performance.now();
      el.textContent = prefix + fmt(0, decimals) + suffix;
      function step(now) {
        var t = Math.min(1, (now - start) / duration);
        var eased = 1 - Math.pow(1 - t, 3);
        var v = to * eased;
        el.textContent = prefix + fmt(v, decimals) + suffix;
        if (t < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    var counterIO = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          animateCounter(e.target);
          counterIO.unobserve(e.target);
        }
      });
    }, { threshold: 0.6 });
    document.querySelectorAll('.motion-count[data-count-to]').forEach(function (el) {
      counterIO.observe(el);
    });

    // Auto-tag common blocks for scroll reveal (no explicit class needed)
    var autoRevealSelectors = [
      '.card',
      '.service-card',
      '.metric-card',
      '.compare-table',
      '.raw-block',
      '.cite-card',
      '.patent-claim',
      '.ev-box',
      '.ev3-card',
      '.fact-bar',
      '.price-card',
      '.callout-note',
      '.must-card',
      '.must-not-card',
      '.sim-box',
    ];
    document.querySelectorAll(autoRevealSelectors.join(',')).forEach(function (el) {
      if (el.closest('.motion-stagger')) return;
      el.classList.add('motion-fade');
      inViewIO.observe(el);
    });

    // ── Auto-hero stagger: promote .hero > .container to .motion-hero ──
    document.querySelectorAll('.hero > .container, .hero > .container--narrow').forEach(function (el) {
      el.classList.add('motion-hero');
      var children = el.children;
      for (var i = 0; i < children.length; i++) {
        children[i].style.transitionDelay = (i * 0.10).toFixed(3) + 's';
      }
      inViewIO.observe(el);
    });

    // ── Auto-h2 fade: promote every main h2 to .motion-h2 ──
    document.querySelectorAll('main h2').forEach(function (el) {
      if (el.closest('.motion-formula') || el.closest('.motion-hero')) return;
      el.classList.add('motion-h2');
      inViewIO.observe(el);
    });

    // ── Auto-stagger common grid/flow containers (children reveal one-by-one) ──
    var autoStaggerSelectors = [
      '.metric-grid',
      '.ev3',
      '.service-grid',
      '.three-steps',
      '.hero__badges',
      '.hero__cta-group',
      '.cta-analysis__visual',
    ];
    document.querySelectorAll(autoStaggerSelectors.join(',')).forEach(function (el) {
      if (el.classList.contains('motion-stagger')) return;
      // Skip if already inside a stagger container
      if (el.closest('.motion-stagger') && el.closest('.motion-stagger') !== el) return;
      el.classList.add('motion-stagger');
      var children = el.children;
      for (var i = 0; i < children.length; i++) {
        children[i].style.transitionDelay = (i * 0.10).toFixed(3) + 's';
      }
      inViewIO.observe(el);
    });

    // ── Primary CTA pulse: observe .btn--primary so it can get .is-visible ──
    document.querySelectorAll('.btn--primary').forEach(function (el) {
      inViewIO.observe(el);
    });

    // ── Proof / Showcase Panel auto-cycler ──
    document.querySelectorAll('.proof-panel').forEach(function (panel) {
      var slides = panel.querySelectorAll('.proof-slide');
      var dots   = panel.querySelectorAll('.proof-dot');
      var timerEl = panel.querySelector('.proof-panel__timer');
      if (!slides.length) return;
      var current = 0;
      var interval = 4200;
      var autoTimeout = null;
      var timerRAF = null;
      var timerStart = null;

      function animateNumIn(el) {
        var to = parseFloat(el.dataset.countTo);
        if (Number.isNaN(to)) return;
        var decimals = parseInt(el.dataset.decimals || '0', 10);
        var duration = 1000;
        var start = performance.now();
        el.textContent = fmt(0, decimals);
        function step(now) {
          var t = Math.min(1, (now - start) / duration);
          var eased = 1 - Math.pow(1 - t, 3);
          el.textContent = fmt(to * eased, decimals);
          if (t < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }
      function activate(i) {
        slides.forEach(function (s, idx) { s.classList.toggle('is-active', idx === i); });
        dots.forEach(function (d, idx)   { d.classList.toggle('is-active', idx === i); });
        var n = slides[i].querySelector('.proof-num');
        if (n) animateNumIn(n);
        current = i;
        startTimer();
      }
      function startTimer() {
        if (timerRAF) cancelAnimationFrame(timerRAF);
        timerStart = performance.now();
        function tick(now) {
          var elapsed = now - timerStart;
          var remaining = Math.ceil((interval - elapsed) / 1000);
          if (timerEl) timerEl.textContent = 'next in ' + Math.max(0, remaining) + 's';
          if (elapsed < interval) timerRAF = requestAnimationFrame(tick);
        }
        timerRAF = requestAnimationFrame(tick);
      }
      function scheduleNext() {
        clearTimeout(autoTimeout);
        autoTimeout = setTimeout(function () {
          activate((current + 1) % slides.length);
          scheduleNext();
        }, interval);
      }
      dots.forEach(function (d) {
        d.addEventListener('click', function () {
          activate(parseInt(d.dataset.i, 10));
          scheduleNext();
        });
      });
      activate(0);
      scheduleNext();
    });
  })();
  </script>
</body>
</html>
