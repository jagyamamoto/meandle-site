---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Form endpoint — same-origin Pages Function（functions/api/contact.ts）。
 * panam.travelsim-japan.com で実運用中の方式の移植。Resend REST で
 * CONTACT_TO（既定 danke@jagproject.com）へ送る。
 * Publishing gate: Pages の環境変数 RESEND_API_KEY 未設定のままでは
 * 送信時に案内つき500を返す（フォーム自体は表示される）。
 */
const FORM_ENDPOINT = '/api/contact';

const title = '既存URLの導入適合性を確認する｜Meandle';
const description = 'Meandleの導入適合性を、既存URLから確認します。対象・価値・根拠・対象外条件を整理する初回の意味適合スプリントは、1商材・1URLで50万円〜です。';
const ogTitle = '既存URLから、意味適合スプリントの導入適合性を確認する｜Meandle';
const ogDescription = 'お問い合わせ段階で詳細診断を行うページではありません。対象URL、商材、対象顧客、対象外条件を確認し、適合する場合に50万円〜のスプリントをご案内します。';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': 'https://meandle.jp/contact/#webpage',
    url: 'https://meandle.jp/contact/',
    name: title,
    description: description,
    isPartOf: { '@id': 'https://meandle.jp/#website' },
    about: { '@id': 'https://meandle.jp/do-meandle/#service' },
    inLanguage: 'ja',
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://meandle.jp/' },
        { '@type': 'ListItem', position: 2, name: '導入適合性の確認', item: 'https://meandle.jp/contact/' },
      ],
    },
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="/contact/"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  structuredData={structuredData}
>
  <!-- Section 1: Hero (C: no image) -->
  <section class="hero hero--split">
    <div class="hero__bg-grid" aria-hidden="true"></div>
    <div class="hero__bg-noise" aria-hidden="true"></div>
    <div class="container">
      <nav class="breadcrumb"><a href="/">ホーム</a>　/　導入適合性の確認</nav>
      <div class="hero__split">
        <div class="hero__left">
          <span class="eyebrow hero__eyebrow">Meaning Fit Check</span>
          <h1 class="hero-copy">そのページは、正しい相手に、<br/>正しい理由で伝わっていますか。</h1>

          <p class="lead" style="margin-top:20px">
            高単価で説明が複雑なB2B商材は、情報を増やすだけでは伝わりません。誰の、どの場面に必要か。何と比べられ、何ではないのか。既存URLを起点に、その境界を確認します。
          </p>
          <p>
            このフォームは、お問い合わせ段階で詳細診断を行うためのものではありません。Meandleで扱うべき課題かを確認し、適合する場合に初回有償スプリントをご案内するための入口です。
          </p>

          <p style="margin-top:16px"><strong>初回は、1商材・1URLの意味適合スプリント 50万円〜です。</strong></p>

          <div class="hero__cta-group">
            <a href="#fit-form" class="btn btn--primary">既存URLで導入適合性を確認する</a>
          </div>
          <p style="font-size:13px; color:var(--muted); margin-top:12px">
            対象URL、来てほしい顧客、対象外にしたい顧客や用途をお知らせください。順位、AI応答、商談成果を保証する支援や、記事の量産は行いません。
          </p>
        </div>

        <aside class="proof-panel" aria-label="適合確認フロー ライブ表示">
          <div class="proof-panel__head">
            <span class="proof-panel__led"></span>
            <span class="proof-panel__label">FIT&nbsp;CHECK&nbsp;FLOW</span>
            <span class="proof-panel__timer"></span>
          </div>
          <div class="proof-stage">
            <div class="proof-slide is-active">
              <div class="proof-slide__type">Step 1</div>
              <div class="proof-slide__num proof-slide__num--label">URL 送信</div>
              <div class="proof-slide__name">1つの既存URL＋基本情報</div>
              <div class="proof-slide__body">既存URL、商材、来てほしい相手、対象外にしたい用途、現在のズレを送信いただきます。</div>
              <div class="proof-slide__query">not a diagnosis request</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">Step 2</div>
              <div class="proof-slide__num proof-slide__num--label">前提確認</div>
              <div class="proof-slide__name">対象外条件・根拠・時期・予算</div>
              <div class="proof-slide__body">対象・対象外の条件、根拠資料、意思決定への関与、時期と予算を確認します。</div>
              <div class="proof-slide__query">50万円〜の有償スプリント前提</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">Step 3</div>
              <div class="proof-slide__num proof-slide__num--label">Go / Hold</div>
              <div class="proof-slide__name">適合回答をお返しします</div>
              <div class="proof-slide__body">適合する場合に有償スプリントの進め方を、しない場合はHoldの理由と別施策の候補をご案内します。</div>
              <div class="proof-slide__query">日程予約は自動開放しません</div>
            </div>
          </div>
          <div class="proof-panel__dots">
            <button class="proof-dot is-active" data-i="0" aria-label="送信"></button>
            <button class="proof-dot" data-i="1" aria-label="前提確認"></button>
            <button class="proof-dot" data-i="2" aria-label="Go/Hold"></button>
          </div>
        </aside>
      </div>

      <div class="hero-marquee" aria-hidden="true">
        <div class="hero-marquee__track">
          <span class="hero-marquee__lead">◉ MEANING FIT CHECK</span>
          <span>▸ 50万円〜のスプリント適合確認</span>
          <span>▸ お問い合わせ段階での詳細診断は行いません</span>
          <span>▸ 対象・対象外・価値・根拠</span>
          <span>▸ patent pending</span>
          <span class="hero-marquee__lead">◉ MEANING FIT CHECK</span>
          <span>▸ 50万円〜のスプリント適合確認</span>
          <span>▸ お問い合わせ段階での詳細診断は行いません</span>
          <span>▸ 対象・対象外・価値・根拠</span>
          <span>▸ patent pending</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Scope -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">Paid First Step</span>
      <h2>最初の50万円〜で、直す前に「何を直すか」を決めます。</h2>
      <p>意味適合スプリントは、ページをすぐに作り替える商品ではありません。対象URLを一つに絞り、現在の説明と、実際に来てほしい相手とのズレを確認します。</p>
      <p>その上で、誰に、何として、なぜ提供し、何は対象外かを意味仕様にまとめます。実装へ進むかどうかは、その仕様と優先順位を確認してから決めます。</p>

      <div class="grid grid--2 mt-4">
        <div class="card">
          <h3>現状の意味診断</h3>
          <p style="margin-bottom:0">現在のページが、何のサービスとして読まれ得るかを確認します。対象、価値、根拠、比較軸の不足を整理します。</p>
        </div>
        <div class="card">
          <h3>対象／対象外の質問</h3>
          <p style="margin-bottom:0">出てほしい質問だけでなく、出るべきではない質問も定めます。問い合わせと営業説明の基準になります。</p>
        </div>
        <div class="card">
          <h3>8項目の意味仕様</h3>
          <p style="margin-bottom:0">役割、利用場面、比較対象、比較軸、価値、根拠、必須条件、対象外条件を一つにまとめます。</p>
        </div>
        <div class="card">
          <h3>実装方針と検証条件</h3>
          <p style="margin-bottom:0">次に直す箇所の優先順位と、変更後に何を比較するかを整理します。ページ実装そのものは含みません。</p>
        </div>
      </div>

      <div class="callout-note">
        <strong>明確に含まれないこと：</strong>詳細なページ実装、記事の量産、広告運用、順位やAI応答の保証は、意味適合スプリントの範囲に含まれません。
      </div>
    </div>
  </section>

  <!-- Section 3: Fit -->
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">Fit Before Work</span>
      <h2>URLがあっても、すべての課題をMeandleで扱うわけではありません。</h2>
      <p>意味設計は、対象顧客と対象外条件を事業側で確認できることを前提とします。次の条件がそろうかを、送信前にご確認ください。</p>

      <div class="grid grid--2 mt-4">
        <div>
          <h3 style="color:var(--hero-orange)">向いているケース</h3>
          <ul>
            <li>一件の商談価値が高く、説明のズレによる損失が大きい</li>
            <li>新しいカテゴリ、専門技術、複合サービスを扱っている</li>
            <li>競合と同じ言葉で説明され、価格以外の違いが伝わりにくい</li>
            <li>対象外の問い合わせに営業工数を使っている</li>
            <li>既存サイトと営業資料があり、事実確認に協力できる</li>
            <li>90日以内に整えたい商材とURLを一つに絞れる</li>
            <li>事業責任者または意思決定に関わる人が確認に参加できる</li>
          </ul>
        </div>
        <div>
          <h3 style="color:var(--muted)">向いていないケース</h3>
          <ul>
            <li>月額の順位計測だけを求めている</li>
            <li>記事の本数だけを増やしたい</li>
            <li>短期的な結果保証を前提としている</li>
            <li>誰を対象外にするかを決められない</li>
            <li>商材の事実、顧客像、営業上の課題を共有できない</li>
            <li>50万円〜の有償スプリントから始める予算がない</li>
          </ul>
        </div>
      </div>

      <p style="margin-top:20px">適合しない場合は、広告、計測、SEO、サイト制作など、別の施策を先に行う方が合理的です。送信内容からMeandleの対象条件を確認し、適合する場合に有償スプリントの進め方をご案内します。</p>
    </div>
  </section>

  <!-- Section 4: Method (4-panel) -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">From URL to Decision</span>
      <h2>送信前提を確認し、有償スプリントの対象かを判断します。</h2>
      <p>このフォームでは、詳細な意味診断やページの改善案は作りません。対象URLと基本条件を確認し、50万円〜の意味適合スプリントで扱うべき案件かを判断します。</p>

      <div class="algo-flow motion-flow">
        <svg viewBox="0 0 900 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="適合確認の4段階">
          <defs><marker id="arrow-ct" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="10" markerHeight="10" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#12242C"/></marker></defs>
          <g font-family="var(--font-mono)" font-size="12" fill="#12242C">
            <text x="450" y="26" text-anchor="middle" font-size="13" font-weight="700" fill="#E98F22">Fit Check · 4-step</text>
            <rect x="20"  y="60" width="180" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
            <text x="110" y="92"  text-anchor="middle" font-size="13" font-weight="700">① URL送信</text>
            <text x="110" y="118" text-anchor="middle" font-size="11" fill="#6F7777">既存URL＋基本情報</text>
            <line x1="200" y1="100" x2="213" y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow-ct)"/>
            <rect x="235" y="60" width="180" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
            <text x="325" y="92"  text-anchor="middle" font-size="13" font-weight="700">② 前提確認</text>
            <text x="325" y="118" text-anchor="middle" font-size="11" fill="#6F7777">対象外・根拠・時期</text>
            <line x1="415" y1="100" x2="428" y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow-ct)"/>
            <rect x="450" y="60" width="180" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
            <text x="540" y="92"  text-anchor="middle" font-size="13" font-weight="700">③ 適合判定</text>
            <text x="540" y="118" text-anchor="middle" font-size="11" fill="#6F7777">Jag が確認</text>
            <line x1="630" y1="100" x2="643" y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow-ct)"/>
            <rect x="665" y="60" width="215" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
            <text x="772" y="92"  text-anchor="middle" font-size="13" font-weight="700">④ Go / Hold 回答</text>
            <text x="772" y="118" text-anchor="middle" font-size="11" fill="#6F7777">スプリント案内 or 別施策提案</text>
          </g>
        </svg>
      </div>

      <ol class="mt-4" style="font-size:15.5px; line-height:1.95">
        <li><strong>URLと基本情報を送る</strong>：既存URL、商材、来てほしい相手、現在のズレをお知らせください。</li>
        <li><strong>前提条件を確認する</strong>：対象外条件、根拠資料、意思決定への関与、時期と予算を確認します。</li>
        <li><strong>スプリントへの適合性を見る</strong>：有償スプリントの対象か、追加情報が必要か、別の施策が先かを確認します。</li>
        <li><strong>適合回答を受け取る</strong>：適合する場合に有償スプリントの進め方を案内し、適合しない場合はHoldとして回答します。</li>
      </ol>

      <p style="margin-top:16px">この送信だけで、意味仕様、実装方針、改善案を作成するものではありません。それらは、適合後の有償スプリントで作成します。</p>
    </div>
  </section>

  <!-- Section 5: Commercial path -->
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">Three Commercial Steps</span>
      <h2>まず設計し、必要な場合だけ実装と継続検証へ進みます。</h2>
      <p>すべての案件を実装や継続へ進める前提にはしません。スプリントで意味と実装範囲を確認し、次の段階が必要な場合だけ個別に設計します。</p>

      <div class="price-card mt-4">
        <div class="price-label">1. 意味適合スプリント</div>
        <div class="price">¥500,000<span class="price-unit">〜 / 1商材・1URL</span></div>
        <p style="margin-bottom:0">現状の意味診断、対象／対象外質問、8項目の意味仕様、実装方針、検証条件を整理します。</p>
      </div>
      <div class="price-card">
        <div class="price-label">2. 1ページの意味実装</div>
        <div class="price">¥2,000,000<span class="price-unit"> 前後 / ページ</span></div>
        <p style="margin-bottom:0">スプリントで定めた意味仕様を、見出し、本文、比較軸、根拠、FAQ、メタ情報まで一貫したページへ反映します。初回の比較条件も整えます。</p>
      </div>
      <div class="price-card">
        <div class="price-label">3. 回帰検証と更新</div>
        <div class="price">¥1,200,000<span class="price-unit"> / 月〜</span></div>
        <p style="margin-bottom:0">複数ページや複数商材に広げ、公開情報、市場、商材の変化による意味のズレを確認し、更新します。</p>
      </div>

      <div class="callout-note">
        表示価格は提供価格の下限または目安です。対象商材、ページ数、事実確認、実装範囲により個別に設計します。外部環境での表示や商談成果を保証するものではありません。
      </div>

      <p style="margin-top:12px"><a href="/do-meandle/">do.meandleの進め方を見る →</a></p>
    </div>
  </section>

  <!-- Section 6: Form -->
  <section class="section section--alt" id="fit-form">
    <div class="container container--narrow">
      <span class="eyebrow">Submit One Existing URL</span>
      <h2>導入適合性を確認するために、既存URLをお送りください。</h2>
      <p>送信内容からMeandleの対象条件を確認します。詳細な意味診断や実装方針の提示は、適合後の有償スプリントで行います。</p>

      <div class="callout-note" id="form-notice">
        <strong>初回商品：</strong>意味適合スプリント 50万円〜。この送信だけで詳細診断や実装を開始することはありません。
      </div>

      <form class="form" style="margin-top:24px" action={FORM_ENDPOINT} method="POST" aria-describedby="form-notice">
        <!-- Honeypot (visually hidden, screen-reader-hidden) -->
        <div style="position:absolute; left:-9999px; opacity:0" aria-hidden="true">
          <label>この欄は空欄のままにしてください<input type="text" name="honeypot" tabindex="-1" autocomplete="off"/></label>
        </div>
        <!-- タイムトラップ用（描画時刻。JS無効時は空のまま＝判定を素通し） -->
        <input type="hidden" name="t" id="form-t" value=""/>

        <div class="form-field">
          <label for="company">会社名 <span class="req">必須</span></label>
          <input id="company" name="会社名" type="text" required autocomplete="organization"/>
        </div>
        <div class="form-field">
          <label for="name">氏名 <span class="req">必須</span></label>
          <input id="name" name="氏名" type="text" required autocomplete="name"/>
        </div>
        <div class="form-field">
          <label for="email">メールアドレス <span class="req">必須</span></label>
          <input id="email" name="メールアドレス" type="email" required autocomplete="email"/>
        </div>
        <div class="form-field">
          <label for="role">役割 <span class="req">必須</span></label>
          <select id="role" name="役割" required>
            <option value="">選択してください</option>
            <option value="経営者">経営者</option>
            <option value="事業責任者">事業責任者</option>
            <option value="マーケティング・営業責任者">マーケティング・営業責任者</option>
            <option value="広報・ブランド責任者">広報・ブランド責任者</option>
            <option value="その他">その他</option>
          </select>
        </div>
        <div class="form-field">
          <label for="url">対象URL <span class="req">必須</span></label>
          <input id="url" name="対象URL" type="url" required placeholder="https://... （公開前ページの場合は補足欄にその旨を記入）"/>
        </div>
        <div class="form-field">
          <label for="contract">対象商材の平均契約額 <span class="req">必須</span></label>
          <select id="contract" name="対象商材の平均契約額" required>
            <option value="">選択してください</option>
            <option value="100万円未満">100万円未満</option>
            <option value="100万〜500万円未満">100万〜500万円未満</option>
            <option value="500万〜1,000万円未満">500万〜1,000万円未満</option>
            <option value="1,000万円以上">1,000万円以上</option>
            <option value="個別見積もり中心">個別見積もり中心</option>
          </select>
        </div>
        <div class="form-field">
          <label for="target">本来来てほしい顧客 <span class="req">必須</span></label>
          <textarea id="target" name="本来来てほしい顧客" rows="3" required placeholder="業種・役職・導入場面・困りごとを記入"></textarea>
        </div>
        <div class="form-field">
          <label for="nontarget">対象外にしたい顧客または用途 <span class="req">必須</span></label>
          <textarea id="nontarget" name="対象外にしたい顧客または用途" rows="3" required placeholder="ない場合も「現時点では未定」と記入"></textarea>
        </div>
        <div class="form-field">
          <label for="gap">今起きている説明や問い合わせのズレ <span class="req">必須</span></label>
          <textarea id="gap" name="ズレ" rows="3" required placeholder="誤解される用途、比較、問い合わせ、営業説明の例"></textarea>
        </div>
        <div class="form-field">
          <label for="timing">希望時期 <span class="req">必須</span></label>
          <select id="timing" name="希望時期" required>
            <option value="">選択してください</option>
            <option value="30日以内">30日以内</option>
