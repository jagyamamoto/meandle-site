---
import WizardPrototypeLayout from '../../../../../layouts/WizardPrototypeLayout.astro';
import WizardCampaignHeader from '../../../../../components/wizard/WizardCampaignHeader.astro';
import WizardStageNav from '../../../../../components/wizard/WizardStageNav.astro';
import { DEMO_FINDINGS, DEMO_TARGET_FINDINGS } from '../../../../../data/wizard-prototype';

const allFindings = [...DEMO_FINDINGS, ...DEMO_TARGET_FINDINGS];
const countBySeverity = (severity: string) =>
  allFindings.filter((f) => f.severity === severity).length;
const blockerCount = countBySeverity('公開前に直す');
const warnCount = countBySeverity('確認が必要');
const suggestCount = countBySeverity('改善候補');
---
<WizardPrototypeLayout title="公開前チェック" description="Meandle Wizard 操作デモ — 公開前チェック" stage="preflight">
  <WizardCampaignHeader slot="header" />
  <WizardStageNav slot="stage" current="preflight" />

  <div data-wp-when-resolved="f-industry-no1">
    <div class="wp-callout wp-callout--success">
      <strong>「業界No.1」の指摘は対応済みです。</strong>
      <p>
        残りの「公開前に直す」項目（{blockerCount - 1}件）と、確認が必要 {warnCount}件、改善候補 {suggestCount}件を確認してください。
      </p>
    </div>
  </div>

  <div data-wp-when-unresolved="f-industry-no1">
    <div class="wp-callout wp-callout--danger">
      <strong>公開前に直す項目が {blockerCount}件 あります</strong>
      <p>
        「業界No.1」の根拠が確認できていません。この項目を対応するか、代理店レビュー担当が理由付きで例外受容するまで、クライアント確認画面は作成できません。
      </p>
    </div>
  </div>

  <div data-wp-when-target-mode="both_separate" hidden>
    <div class="wp-callout wp-callout--danger">
      <strong>対象方針と成果物が一致していません</strong>
      <p>
        「両方を別の原稿・LP・チャネルで扱う」を選んでいますが、成果物が主対象向けの1種類しかありません。原則として「公開前に直す」項目です。
      </p>
    </div>
  </div>

  <div data-wp-when-no-target-decision hidden>
    <div class="wp-callout wp-callout--warning">
      <strong>対象方針がまだ決まっていません</strong>
      <p>
        選んだ対象に根拠があるかを判定できません。
        <a href="/wizard/campaign/demo/meaning/">伝え方の基準で対象方針を決める →</a>
      </p>
    </div>
  </div>

  <div data-wp-when-target-decided hidden>
    <div class="wp-callout wp-callout--info">
      <strong>対象方針: <span data-wp-target-mode-label></span>（<span data-wp-target-version-out></span>）</strong>
      <p>この方針に照らして、対象の混在・根拠の流用・CTAの整合をチェックしています。</p>
    </div>
  </div>

  <div class="wp-split wp-split--three">
    <div>
      <h2 style="font-size:16px;margin:0 0 12px;">指摘一覧</h2>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <div class="wp-card wp-card--tight" style="border-left:4px solid var(--wp-danger);">
          <div style="font-size:12px;color:var(--wp-danger);font-weight:700;">公開前に直す</div>
          <p style="margin:4px 0 0;font-size:14px;font-weight:600;">{blockerCount}件</p>
        </div>
        <div class="wp-card wp-card--tight" style="border-left:4px solid var(--wp-warning);">
          <div style="font-size:12px;color:var(--wp-warning);font-weight:700;">確認が必要</div>
          <p style="margin:4px 0 0;font-size:14px;font-weight:600;">{warnCount}件</p>
        </div>
        <div class="wp-card wp-card--tight" style="border-left:4px solid #6b7280;">
          <div style="font-size:12px;color:#6b7280;font-weight:700;">改善候補</div>
          <p style="margin:4px 0 0;font-size:14px;font-weight:600;">{suggestCount}件</p>
        </div>
      </div>

      <p style="font-size:12px;color:var(--wp-ink-muted);margin-top:16px;">
        wideレイアウト（1,280px以上）では、原稿と根拠を3ペインで並べて確認します。
      </p>
    </div>

    <div>
      <h2 style="font-size:16px;margin:0 0 12px;">原稿と修正候補</h2>
      {allFindings.map((f) => (
        <div class="wp-finding" data-severity={f.severity}>
          <div class="wp-finding__head">
            <span class="wp-badge" class:list={[f.severity === '公開前に直す' ? 'wp-badge--danger' : f.severity === '確認が必要' ? 'wp-badge--warning' : 'wp-badge--neutral']}>
              {f.severity}
            </span>
            <h3 class="wp-finding__title">{f.title}</h3>
          </div>
          <dl class="wp-finding__body">
            <dt>対象箇所</dt>
            <dd>{f.affected}</dd>
            <dt>問題の理由</dt>
            <dd>{f.reason}</dd>
            <dt>現在の記述</dt>
            <dd><div class="wp-finding__current">{f.currentText}</div></dd>
            <dt>参照根拠</dt>
            <dd>{f.evidenceRef}</dd>
            <dt>修正案</dt>
            <dd><div class="wp-finding__suggested">{f.suggestedFix}</div></dd>
            <dt>担当</dt>
            <dd>{f.owner}</dd>
          </dl>
          <div class="wp-finding__actions">
            <button class="wp-btn wp-btn--primary" type="button" data-wp-resolve-finding={f.id}>
              修正文を採用
            </button>
            <button class="wp-btn wp-btn--secondary" type="button">自分で修正</button>
            <button class="wp-btn wp-btn--secondary" type="button">クライアントに確認</button>
            {f.severity !== '公開前に直す' && (
              <button class="wp-btn wp-btn--ghost" type="button">今回は対応しない（理由必須）</button>
            )}
            {f.severity === '公開前に直す' && (
              <button class="wp-btn wp-btn--ghost" type="button" disabled aria-disabled="true" title="代理店レビュー担当のみが例外受容できます">
                リスクを受け入れる（レビュー担当のみ）
              </button>
            )}
          </div>
        </div>
      ))}
    </div>

    <div>
      <h2 style="font-size:16px;margin:0 0 12px;">根拠と基準</h2>
      <div class="wp-card wp-card--tight">
        <p style="font-size:13px;color:var(--wp-ink-muted);margin:0 0 8px;">
          この指摘は次の判断カードと関連しています。
        </p>
        <ul class="wp-list">
          <li style="font-size:13px;padding:8px;border:1px solid var(--wp-border);border-radius:6px;">
            <strong>何を根拠に言えるか</strong>
            <span style="display:block;color:var(--wp-warning);font-size:12px;">クライアント確認が必要</span>
          </li>
          <li style="font-size:13px;padding:8px;border:1px solid var(--wp-border);border-radius:6px;">
            <strong>向かないケース・言い切れないこと</strong>
            <span style="display:block;color:var(--wp-success);font-size:12px;">確認済み</span>
          </li>
        </ul>

        <p style="font-size:13px;color:var(--wp-ink-muted);margin-top:16px;">
          <strong>修正候補の考え方</strong><br />
          「業界No.1」→「導入企業へのヒアリングで高評価をいただいた」など、成果を保証しない表現へ差し替えます。
        </p>
      </div>
    </div>
  </div>

  <div style="display:flex;justify-content:space-between;margin-top:24px;flex-wrap:wrap;gap:8px;">
    <a class="wp-btn wp-btn--secondary" href="/wizard/campaign/demo/meaning/">← 伝え方の基準に戻る</a>
    <a class="wp-btn wp-btn--primary" href="/wizard/campaign/demo/approval/preview/" data-wp-when-resolved="f-industry-no1">
      クライアント確認画面を作成 →
    </a>
    <span data-wp-when-unresolved="f-industry-no1" class="wp-btn wp-btn--secondary" aria-disabled="true" style="opacity:0.6;cursor:not-allowed;">
      公開前に直す項目を対応するまで進めません
    </span>
  </div>
</WizardPrototypeLayout>
