---
import WizardPrototypeLayout from '../../../../../../layouts/WizardPrototypeLayout.astro';
import WizardCampaignHeader from '../../../../../../components/wizard/WizardCampaignHeader.astro';
import WizardStageNav from '../../../../../../components/wizard/WizardStageNav.astro';
import WizardStageThreshold from '../../../../../../components/wizard/WizardStageThreshold.astro';
import WizardReportPanel from '../../../../../../components/wizard/WizardReportPanel.astro';
import {
  DEMO_APPROVAL_ITEMS,
  DEMO_APPROVERS,
  DEMO_TARGET_APPROVAL_ITEM,
  DEMO_TARGETS,
  DEMO_TARGET_ARTIFACTS,
  DEMO_LEDGER,
  DEMO_SOURCE_TYPE_LABELS,
  TOTAL_PREFLIGHT_FINDINGS,
} from '../../../../../../data/wizard-prototype';

function approverName(id: string) {
  return DEMO_APPROVERS.find((a) => a.id === id)?.name ?? id;
}

function targetName(id: string) {
  return DEMO_TARGETS.find((t) => t.id === id)?.neutralName ?? id;
}

const approvalItems = [DEMO_TARGET_APPROVAL_ITEM, ...DEMO_APPROVAL_ITEMS];
const approverCount = new Set(approvalItems.flatMap((i) => i.assignedTo)).size;
const approverNames = DEMO_APPROVERS.map((a) => a.name).join('／');
---
<WizardPrototypeLayout title="クライアント確認の作成" description="Meandle Wizard 操作デモ — クライアント確認の作成・プレビュー" stage="approval">
  <WizardCampaignHeader slot="header" />
  <WizardStageNav slot="stage" current="approval" />

  <WizardReportPanel />
  <WizardStageThreshold makes="承認記録つきの公開版" receivedFrom="点検済みの原稿" />

  <div class="wp-card wp-card--tight" style="background:var(--wp-page);">
    <p style="font-size:13px;margin:0;">
      この文書の裏づけ: 確認済みの根拠 <span data-wp-confirmed-evidence-count>3</span>件 ・
      出典 {DEMO_SOURCE_TYPE_LABELS.length}種 ・
      承認 {DEMO_APPROVERS.length}名（{approverNames}・{DEMO_LEDGER.approvalDone}） ・
      点検 {TOTAL_PREFLIGHT_FINDINGS}項目 記録済み
    </p>
    <p style="font-size:12px;color:var(--wp-ink-muted);margin:6px 0 0;">
      総合スコアは表示しません。裏づけは上記の内訳のとおりです。※デモ用の架空データです
    </p>
  </div>

  <div class="wp-callout wp-callout--info">
    <strong>クライアントに送る前に、内容と表示を確認してください</strong>
    <p>社内限定の根拠と代理店メモは表示されません。承認スコープを選び、プレビューで確認したうえで送信してください。</p>
  </div>

  <div class="wp-split">
    <div>
      <h2 style="font-size:18px;margin:0 0 12px;">承認依頼の設定</h2>
      <div class="wp-card">
        <h3>承認スコープ</h3>
        <label style="display:flex;gap:8px;padding:8px 0;font-size:14px;">
          <input type="radio" name="scope" checked /> 事実・約束・対象外の確認
        </label>
        <label style="display:flex;gap:8px;padding:8px 0;font-size:14px;">
          <input type="radio" name="scope" /> 事実・約束＋最終原稿の承認（公開版として承認）
        </label>

        <h3 style="margin-top:16px;">依頼内容</h3>
        <div data-wp-when-target-stale hidden class="wp-callout wp-callout--warning" style="margin-bottom:12px;">
          <strong>対象方針が変更されたため、この項目は再確認になります</strong>
          <p>関係のない承認済み項目はそのまま維持されます。</p>
        </div>
        <ul class="wp-list" style="font-size:13px;">
          {approvalItems.map((item) => (
            <li style="padding:8px 12px;border:1px solid var(--wp-border);border-radius:6px;">
              <strong>{item.scope}</strong>：{item.question}
              <div style="color:var(--wp-ink-muted);font-size:12px;margin-top:4px;">
                承認者: {item.assignedTo.map(approverName).join(' / ')}
                {item.assignedTo.length > 1 && <span style="color:var(--wp-danger);"> (全員の承認が必要)</span>}
              </div>
            </li>
          ))}
        </ul>

        <h3 style="margin-top:16px;">対象方針の内容（クライアントに表示されます）</h3>
        <dl class="wp-target__dl">
          <dt>現在の主対象</dt><dd>{targetName('tg-main')}</dd>
          <dt>新しい対象候補</dt><dd>{targetName('tg-multisite')}（未検証の仮説）</dd>
          <dt>選択した方針</dt>
          <dd>
            <span data-wp-when-target-decided hidden data-wp-target-mode-label></span>
            <span data-wp-when-no-target-decision hidden>未決定（伝え方の基準で決めてください）</span>
          </dd>
          <dt>方針の決め手</dt>
          <dd><span data-wp-target-rationale-out>—</span></dd>
          <dt>採用しなかった候補の扱い</dt>
          <dd>今回は本番原稿へ含めず、検証結果を待ってから改めて判断します。</dd>
          <dt>未確認の仮定</dt>
          <dd><span data-wp-target-assumptions-out>—</span></dd>
          <dt>対象別に作成する成果物</dt>
          <dd>
            <ul class="wp-list" style="margin-top:4px;">
              {DEMO_TARGET_ARTIFACTS.map((a) => (
                <li>{targetName(a.targetId)}：{a.label}</li>
              ))}
            </ul>
          </dd>
        </dl>

        <h3 style="margin-top:16px;">期限と担当割当</h3>
        <p style="font-size:13px;color:var(--wp-ink-muted);">
          対象方針：佐藤 真紀<br />
          料金・契約条件：田中 健<br />
          商品の約束：佐藤 真紀、田中 健（2名全員の承認が必要）<br />
          対象外：田中 健<br />
          修正案：佐藤 真紀<br />
          回答期限：2026年8月2日 17:00
        </p>

        <div style="margin-top:16px;">
          <p style="font-size:13px;color:var(--wp-ink-muted);">
            <strong>{approvalItems.length}項目を{approverCount}名へ送ります。</strong>
            回答期限は8月2日です。社内限定の根拠3件と代理店メモは表示されません。
          </p>
        </div>

        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;">
          <a class="wp-btn wp-btn--primary" href="/wizard/approval/demo/">
            デモ確認依頼を作成
          </a>
          <button class="wp-btn wp-btn--secondary" type="button">下書きとして保存</button>
        </div>

        <p style="font-size:12px;color:var(--wp-ink-muted);margin-top:12px;">
          プロトタイプでは実メールを送信しません。作成後はクライアント確認画面が別画面で開きます。
        </p>
      </div>
    </div>

    <div>
      <h2 style="font-size:18px;margin:0 0 12px;">クライアント画面プレビュー</h2>
      <div class="wp-card" style="background:var(--wp-page);padding:12px;">
        <div style="max-width:420px;margin:0 auto;background:var(--wp-card);border:1px solid var(--wp-border);border-radius:8px;padding:20px;">
          <div style="font-size:12px;color:var(--wp-ink-muted);letter-spacing:0.06em;margin-bottom:8px;">
            デモ代理店 / Meandle
          </div>
          <h3 style="font-size:16px;margin:0 0 8px;">RelayOne 新サービス発表 の確認依頼</h3>
          <p style="font-size:14px;color:var(--wp-ink-muted);margin:0 0 12px;">
            公開前に、事業上の事実と約束をご確認ください。所要時間は約5分です。
          </p>
          <div style="background:var(--wp-info-soft);padding:8px 12px;border-radius:6px;font-size:13px;color:#1e3a8a;margin-bottom:12px;">
            0 / {approvalItems.length}件を確認済み · 約5分
          </div>
          <div style="border:1px solid var(--wp-border);border-radius:6px;padding:12px;margin-bottom:8px;">
            <span style="font-size:11px;color:var(--wp-ink-muted);">{approvalItems[0].scope}</span>
            <p style="font-size:14px;margin:4px 0;font-weight:600;">{approvalItems[0].question}</p>
            <div style="background:var(--wp-page);padding:8px;border-radius:4px;font-size:13px;">{approvalItems[0].proposed}</div>
            <div style="display:flex;flex-direction:column;gap:6px;margin-top:8px;">
              <button class="wp-btn wp-btn--primary" type="button" disabled>この内容で問題ない</button>
              <button class="wp-btn wp-btn--secondary" type="button" disabled>修正を依頼</button>
            </div>
          </div>
          <p style="font-size:12px;color:var(--wp-ink-muted);text-align:center;">
            （プレビューのため操作は無効）
          </p>
        </div>
        <p style="font-size:12px;color:var(--wp-ink-muted);text-align:center;margin-top:12px;">
          モバイル 420px 幅のプレビュー — デスクトップでも同じ最大幅で表示されます
        </p>
      </div>

      <div class="wp-card" style="margin-top:16px;">
        <h3>クライアント側の画面（プレビュー）</h3>
        <p style="font-size:13px;color:var(--wp-ink-muted);">
          クライアント側の画面ではこのように表示されます。冒頭に裏づけの記録が添付された状態で届きます。本文の数値には出典番号が付き、末尾に承認記録欄が残ります。
        </p>
        <h4 style="font-size:13px;margin:16px 0 8px;">聞かれやすい質問と、答えがある場所</h4>
        <ul class="wp-list" style="font-size:13px;">
          <li style="padding:8px 12px;border:1px solid var(--wp-border);border-radius:6px;">
            「月額25万円の出典は？」→ 根拠リスト ev-price-25（料金表_2026.pdf・2026年6月1日時点）に記載があります。
          </li>
          <li style="padding:8px 12px;border:1px solid var(--wp-border);border-radius:6px;">
            「対象外の条件は？」→ 「向かないケース・言い切れないこと」の判断カードに記載があります。
          </li>
          <li style="padding:8px 12px;border:1px solid var(--wp-border);border-radius:6px;">
            「新しい対象候補はどう扱う？」→ 対象方針の項目に、採用しなかった理由とともに記載があります。
          </li>
        </ul>
      </div>
    </div>
  </div>
</WizardPrototypeLayout>
