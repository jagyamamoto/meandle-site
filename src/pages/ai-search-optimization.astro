---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'AI検索最適化とは｜AIO・LLMO・GEOと意味設計｜Meandle';
const description = 'AI検索最適化、AIO、LLMO、GEOを一次情報で整理。Meandleは、観測結果を高単価B2Bの対象・価値・根拠・対象外条件の意味仕様へ変え、既存ページへ実装します。';
const ogTitle = 'AI検索を測った後、何を直すか。｜Meandle';
const ogDescription = 'AIO・LLMO・GEOの用語と限界を一次情報で整理し、観測結果を既存ページの意味設計へつなぐ方法を説明します。';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://meandle.jp/ai-search-optimization/#webpage',
    url: 'https://meandle.jp/ai-search-optimization/',
    name: title,
    description: description,
    inLanguage: 'ja-JP',
    isPartOf: { '@id': 'https://meandle.jp/#website' },
    about: { '@id': 'https://meandle.jp/do-meandle/#service' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': 'https://meandle.jp/ai-search-optimization/#article',
    mainEntityOfPage: { '@id': 'https://meandle.jp/ai-search-optimization/#webpage' },
    headline: 'AI検索を測った後、何を直すかを決める。',
    description: 'AIO・LLMO・GEOの用語と限界をGoogle、Microsoft、OpenAIの公開資料で整理し、観測結果を既存ページの意味設計へつなぐ方法。',
    inLanguage: 'ja-JP',
    author: { '@type': 'Person', name: 'Jag Yamamoto', url: 'https://jagproject.com/' },
    publisher: { '@id': 'https://meandle.jp/#organization' },
    // datePublished / dateModified are intentionally omitted until Jag confirms the actual publish date.
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="/ai-search-optimization/"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogType="article"
  structuredData={structuredData}
>
  <!-- Section 1: Hero (C) -->
  <section class="hero hero--split">
    <div class="hero__bg-grid" aria-hidden="true"></div>
    <div class="hero__bg-noise" aria-hidden="true"></div>
    <div class="container">
      <nav class="breadcrumb"><a href="/">ホーム</a>　/　AI検索最適化とは</nav>
      <div class="hero__split">
        <div class="hero__left">
          <span class="eyebrow hero__eyebrow">AI Search Optimization</span>
          <h1 class="hero-copy">AI検索を測った後、<br/>何を直すかを決める。</h1>

          <p class="lead" style="margin-top:20px">
            AIO、LLMO、GEOといった言葉は広がっています。しかし、高単価で説明が複雑なB2B商材に必要なのは、観測画面を増やすことだけではありません。誰に、何として、なぜ必要なのか。根拠は何か。誰・どの用途には向かないのか。既存ページがこの条件を一貫して伝えているかを定めることです。
          </p>
          <p>
            Meandleは、検索や生成AIの応答を操作するサービスではありません。観測で見つかった曖昧さを、対象、価値、根拠、対象外条件を含む意味仕様に変え、既存ページへ実装するための設計です。
          </p>
          <p style="color:var(--muted); font-size:14px">
            本ページでは、Google、Microsoft、OpenAIの公開資料に基づき、できることと断定できないことを分けます。公開情報の取得日：2026年7月29日。
          </p>

          <div class="hero__cta-group">
            <a href="/contact/" class="btn btn--primary">既存URLで導入適合性を確認する</a>
          </div>
          <p style="font-size:13px; color:var(--muted); margin-top:12px">
            初回は、1商材・1URLの意味適合スプリント 50万円〜です。検索順位、AIの応答、引用、商談成果を保証するものではありません。
          </p>
        </div>

        <aside class="proof-panel" aria-label="役割の分担 ライブ表示">
          <div class="proof-panel__head">
            <span class="proof-panel__led"></span>
            <span class="proof-panel__label">ROLES&nbsp;NOT&nbsp;LABELS</span>
            <span class="proof-panel__timer"></span>
          </div>
          <div class="proof-stage">
            <div class="proof-slide is-active">
              <div class="proof-slide__type">Role 1</div>
              <div class="proof-slide__num proof-slide__num--label">観測</div>
              <div class="proof-slide__name">Observation</div>
              <div class="proof-slide__body">検索コンソール、参照データ、AI検索観測レポート。<strong>何が見えているか</strong>を残しますが、誰に向けるかは決まりません。</div>
              <div class="proof-slide__query">tools do not decide non-target</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">Role 2</div>
              <div class="proof-slide__num proof-slide__num--label">技術SEO</div>
              <div class="proof-slide__name">Technical SEO</div>
              <div class="proof-slide__body">クロール、インデックス、HTML、構造化データ。<strong>取得・理解できる状態</strong>を整えますが、事業判断は含みません。</div>
              <div class="proof-slide__query">no marketing decision baked in</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">Role 3</div>
              <div class="proof-slide__num proof-slide__num--label">コンテンツ</div>
              <div class="proof-slide__name">Content / SEO 実行</div>
              <div class="proof-slide__body">本文、FAQ、事例、資料を制作・運用。<strong>量産の前</strong>に何を対象外にするかを決める必要があります。</div>
              <div class="proof-slide__query">volume ≠ meaning</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">Role 4</div>
              <div class="proof-slide__num proof-slide__num--label">意味設計</div>
              <div class="proof-slide__name">Meandle · Meaning Design</div>
              <div class="proof-slide__body">対象・価値・根拠・対象外条件を含む意味仕様と実装差分。<strong>正しい相手が、正しい理由で判断できる説明</strong>の層。</div>
              <div class="proof-slide__query">no rank/citation/lead guarantees</div>
            </div>
          </div>
          <div class="proof-panel__dots">
            <button class="proof-dot is-active" data-i="0" aria-label="観測"></button>
            <button class="proof-dot" data-i="1" aria-label="技術SEO"></button>
            <button class="proof-dot" data-i="2" aria-label="コンテンツ"></button>
            <button class="proof-dot" data-i="3" aria-label="意味設計"></button>
          </div>
        </aside>
      </div>

      <div class="hero-marquee" aria-hidden="true">
        <div class="hero-marquee__track">
          <span class="hero-marquee__lead">◉ AI SEARCH · AIO · LLMO · GEO</span>
          <span>▸ Google / Microsoft / OpenAI 一次情報</span>
          <span>▸ 用語ではなく責任範囲で選ぶ</span>
          <span>▸ 意味設計はMeandleが担う層</span>
          <span>▸ 取得日 2026-07-29</span>
          <span class="hero-marquee__lead">◉ AI SEARCH · AIO · LLMO · GEO</span>
          <span>▸ Google / Microsoft / OpenAI 一次情報</span>
          <span>▸ 用語ではなく責任範囲で選ぶ</span>
          <span>▸ 意味設計はMeandleが担う層</span>
          <span>▸ 取得日 2026-07-29</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Terms -->
  <section class="section section--alt" id="terms">
    <div class="container container--narrow">
      <span class="eyebrow">Working Definitions</span>
      <h2>AIO・LLMO・GEOは、共通規格ではなく実務上の呼び名です。</h2>
      <p>これらの略語には、すべての検索サービスや生成AIに共通する公式な定義はありません。ここでは、検討時の混線を避けるために、次の作業用の意味で使います。Googleは、AEO・GEOをオンラインでよく使われる言葉として扱い、Google Searchでの生成AI向けの最適化はSEOと同じ基本に立つと説明しています。（<a href="https://developers.google.com/search/docs/fundamentals/ai-optimization-guide" target="_blank" rel="noopener noreferrer">Google Search Central</a>／取得日：2026年7月29日）</p>

      <div class="table-wrap mt-3">
        <table class="compare-table">
          <thead><tr><th scope="col">用語</th><th scope="col">このページでの作業用の意味</th><th scope="col">誤解しないための補足</th></tr></thead>
          <tbody>
            <tr><td>AIO</td><td>AIが介在する検索・発見経路を見据え、公開情報の読み取りやすさを整える広い呼び方</td><td>Googleの公式なサービス分類ではありません。AIの応答を制御する意味ではありません。</td></tr>
            <tr><td>LLMO</td><td>大規模言語モデルが参照し得る公開情報について、主語、条件、根拠、更新状態を明確にする取り組み</td><td>モデルの回答や引用を約束する用語ではありません。公式の共通規格もありません。</td></tr>
            <tr><td>GEO</td><td>生成AIを含む検索・回答画面で、公開情報がどのように扱われるかを観測・改善する取り組み</td><td>GoogleはGEOを一般的な呼び名として紹介し、SEOの基本を土台としています。MicrosoftはAI PerformanceをGEOに向けた観測機能として公開プレビューしています。</td></tr>
            <tr><td>SEO</td><td>クロール、インデックス、技術的な可読性、利用者に役立つ独自の情報を整える基礎</td><td>生成AI向けの施策とは別世界ではありません。Googleは、既存の検索の基礎と品質システムが生成AI機能にも重要だと説明しています。</td></tr>
          </tbody>
        </table>
      </div>

      <div class="callout-note">
        用語の整理は、サービスの効果を示すものではありません。実際に何を行うべきかは、対象の検索サービス、公開状態、サイトの技術条件、商材の事実と対象顧客によって変わります。
      </div>
    </div>
  </section>

  <!-- Section 3: Primary sources -->
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">What Primary Sources Actually Say</span>
      <h2>まず、公開資料が言っていること以上を約束しない。</h2>
      <p>AI検索に関する提案は、観測の数字や流行語だけで強く見えがちです。一次情報を確認すると、技術的な適格性と、表示・引用・成果の保証は別の話だと分かります。</p>

      <h3 style="margin-top:20px">Google Search</h3>
      <p>Googleは、生成AI機能に向けた最適化について、通常のSEOの基礎を重要な土台として扱っています。人のために作られた、独自性があり信頼できる情報、クロール可能な公開コンテンツ、意味のあるHTML、適切な技術SEOが前提です。一方、生成AIのためだけの特別なマークアップ、<code>llms.txt</code>、ページの分割、AIへの言及を増やす書き換えは必要ないと説明しています。</p>
      <p>また、スニペットの対象となる条件を満たしても、クロール、インデックス、表示が保証されるわけではありません。（<a href="https://developers.google.com/search/docs/fundamentals/ai-optimization-guide" target="_blank" rel="noopener noreferrer">Google Search Central：AI features and your website</a>／取得日：2026年7月29日）</p>

      <h3 style="margin-top:20px">Microsoft Bing / Copilot</h3>
      <p>MicrosoftのBing Webmaster Tools「AI Performance」は、Copilot、BingのAI要約、一部の提携先における引用を確認するための公開プレビューです。ただし、そこで示される引用数は、順位、権威性、表示位置を示すものではないと明記されています。観測は「何が起きたか」を見る材料であり、「どの説明が事業にとって正しいか」を決める材料とは別です。（<a href="https://blogs.bing.com/webmaster/February-2026/Introducing-AI-Performance-in-Bing-Webmaster-Tools-Public-Preview" target="_blank" rel="noopener noreferrer">Microsoft Bing Blogs：Introducing AI Performance in Bing Webmaster Tools</a>／取得日：2026年7月29日）</p>

      <h3 style="margin-top:20px">OpenAI / ChatGPT search</h3>
      <p>OpenAIは、公開サイトがChatGPT searchで見つかり、表示・引用される対象になるためには、<code>OAI-SearchBot</code>をブロックしないことを案内しています。同時に、検索結果での上位表示は保証しないと明示しています。現在のMeandleサイトは公開承認までBasic Authと<code>noindex,nofollow</code>を維持する方針のため、この状態では公開検索向けの確認対象にはなりません。公開時には、Jag承認のもとでサイト全体の公開手順として見直します。（<a href="https://help.openai.com/en/articles/12627856" target="_blank" rel="noopener noreferrer">OpenAI Help：Publishers and developers - FAQ</a>／<a href="https://help.openai.com/en/articles/9237897-chatgpt-search" target="_blank" rel="noopener noreferrer">ChatGPT search</a>／取得日：2026年7月29日）</p>

      <h3 style="margin-top:20px">一次情報の一覧</h3>
      <div class="table-wrap">
        <table class="compare-table">
          <thead><tr><th scope="col">ID</th><th scope="col">公開元・資料</th><th scope="col">本ページで参照する論点</th><th scope="col">取得日</th></tr></thead>
          <tbody>
            <tr><td>PS-01</td><td><a href="https://developers.google.com/search/docs/fundamentals/ai-optimization-guide" target="_blank" rel="noopener noreferrer">Google Search Central：AI features and your website</a></td><td>SEOの基礎、独自性、技術要件、特別なAI用マークアップが必須ではないこと、表示非保証</td><td>2026-07-29</td></tr>
            <tr><td>PS-02</td><td><a href="https://developers.google.com/search/blog/2026/06/gen-ai-performance-reports" target="_blank" rel="noopener noreferrer">Google Search Central Blog：Generative AI performance reports</a></td><td>生成AIのパフォーマンスレポートは一部サイトからの提供であること</td><td>2026-07-29</td></tr>
            <tr><td>PS-03</td><td><a href="https://blogs.bing.com/webmaster/February-2026/Introducing-AI-Performance-in-Bing-Webmaster-Tools-Public-Preview" target="_blank" rel="noopener noreferrer">Microsoft Bing Blogs：AI Performance in Bing Webmaster Tools</a></td><td>引用観測、公開プレビュー、引用数は順位・権威性・位置ではないこと</td><td>2026-07-29</td></tr>
            <tr><td>PS-04</td><td><a href="https://help.openai.com/en/articles/12627856" target="_blank" rel="noopener noreferrer">OpenAI Help：Publishers and developers - FAQ</a></td><td>OAI-SearchBot、公開サイト、参照トラフィックの確認</td><td>2026-07-29</td></tr>
            <tr><td>PS-05</td><td><a href="https://help.openai.com/en/articles/9237897-chatgpt-search" target="_blank" rel="noopener noreferrer">OpenAI Help：ChatGPT search</a></td><td>クロール許可と上位表示の非保証</td><td>2026-07-29</td></tr>
          </tbody>
        </table>
      </div>

      <p style="margin-top:16px">Meandleは、上記の公開資料を「効果の根拠」に読み替えません。技術条件を満たすこと、観測できること、商材の説明が適切であることは、それぞれ別に確認します。</p>
    </div>
  </section>

  <!-- Section 4: Roles -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">Different Jobs, Different Decisions</span>
      <h2>観測、技術SEO、コンテンツ、意味設計は、同じ仕事ではありません。</h2>
      <p>どれか一つを否定するのではなく、意思決定の役割を混ぜないことが重要です。Meandleは、既存のツールやSEOの専門家と競合するのではなく、観測後に「何を、誰へ、どの根拠で伝えるか」を決める層を担います。</p>

      <div class="table-wrap mt-3">
        <table class="compare-table">
          <thead><tr><th scope="col">役割</th><th scope="col">主に答える問い</th><th scope="col">主な成果物</th><th scope="col">それだけでは決まらないこと</th></tr></thead>
          <tbody>
            <tr><td>観測</td><td>どの質問・参照・流入が見えているか</td><td>検索コンソール、参照データ、観測レポート</td><td>誰に向けた商材か、何を捨てるか</td></tr>
            <tr><td>技術SEO</td><td>検索サービスが公開ページを取得・理解しやすいか</td><td>クロール、インデックス、HTML、構造化データの整備</td><td>商材の価値、比較軸、営業上の優先順位</td></tr>
            <tr><td>コンテンツ制作</td><td>必要な事実や説明をページに置けるか</td><td>本文、FAQ、事例、資料</td><td>量を増やすべきか、対象外にすべきか</td></tr>
            <tr class="highlight"><td><strong>Meandleの意味設計</strong></td><td><strong>正しい相手が、正しい理由で判断できる説明か</strong></td><td><strong>対象・価値・根拠・対象外条件を含む意味仕様と実装差分</strong></td><td><strong>順位、引用、AIの応答、商談を保証すること</strong></td></tr>
          </tbody>
        </table>
      </div>

      <p style="margin-top:16px">たとえば、観測で「よく引用される説明」が見つかっても、その説明が低単価の比較を招くなら、増やすべきとは限りません。逆に、技術要件が整っていても、対象顧客、利用場面、根拠、対象外条件が曖昧なら、高単価商材の判断は進みません。</p>
      <p>Meandleが設計するのは、露出を増やす前に、AIと見込み客が拾える「売る意味」を整えることです。</p>
    </div>
  </section>

  <!-- Section 5: Flow -->
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">From Observation to Existing-page Implementation</span>
      <h2>観測結果を、ページの実装条件へ変える4段階です。</h2>
      <p>数字や引用の有無を、正解のコピーに直結させません。対象顧客と商材の事実を確認して初めて、既存ページに反映する条件が定まります。</p>

      <div class="algo-flow motion-flow">
        <svg viewBox="0 0 900 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="観測→実装 4段階">
          <defs><marker id="arrow-aso" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="10" markerHeight="10" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#12242C"/></marker></defs>
          <g font-family="var(--font-mono)" font-size="12" fill="#12242C">
            <text x="450" y="26" text-anchor="middle" font-size="13" font-weight="700" fill="#E98F22">Observation → Existing-page Implementation</text>
            <rect x="20"  y="60" width="180" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
            <text x="110" y="92"  text-anchor="middle" font-size="13" font-weight="700">① 観測する</text>
            <text x="110" y="118" text-anchor="middle" font-size="11" fill="#6F7777">検索/生成AI/営業/問い合わせ</text>
            <line x1="200" y1="100" x2="213" y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow-aso)"/>
            <rect x="235" y="60" width="180" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
            <text x="325" y="92"  text-anchor="middle" font-size="13" font-weight="700">② 読み解く</text>
            <text x="325" y="118" text-anchor="middle" font-size="11" fill="#6F7777">曖昧な主語/比較/条件を分離</text>
            <line x1="415" y1="100" x2="428" y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow-aso)"/>
            <rect x="450" y="60" width="180" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
            <text x="540" y="92"  text-anchor="middle" font-size="13" font-weight="700">③ 意味仕様化</text>
            <text x="540" y="118" text-anchor="middle" font-size="11" fill="#6F7777">8項目仕様＋対象外</text>
            <line x1="630" y1="100" x2="643" y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow-aso)"/>
            <rect x="665" y="60" width="215" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
            <text x="772" y="92"  text-anchor="middle" font-size="13" font-weight="700">④ 既存ページへ実装</text>
            <text x="772" y="118" text-anchor="middle" font-size="11" fill="#6F7777">見出し/本文/比較/根拠/FAQ/メタ</text>
          </g>
        </svg>
      </div>

      <ol class="mt-4" style="font-size:15.5px; line-height:1.95">
        <li><strong>観測する</strong>：検索、生成AI、営業、問い合わせなどから、今どの説明が参照され、どこが混線しているかを確認します。</li>
        <li><strong>読み解く</strong>：観測を正解扱いせず、既存URL、営業資料、事実確認をもとに、曖昧な主語、比較、条件を分けます。</li>
        <li><strong>意味仕様にする</strong>：対象、価値、根拠、対象外条件を含む8項目の意味仕様にし、実装判断をそろえます。</li>
        <li><strong>既存ページへ実装する</strong>：見出し、本文、比較、根拠、FAQ、メタ情報へ反映し、何を観察し、何を断定しないかを定めます。</li>
      </ol>

      <p style="margin-top:16px">この工程で残すのは、単発の「AI検索向けコピー」ではありません。ページの変更理由、実装差分、確認条件、次回更新時に見直す条件です。</p>
