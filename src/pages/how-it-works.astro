---
import BaseLayout from '../layouts/BaseLayout.astro';

const eightFields = [
  { num: 1, name: 'ジョブ',   desc: '顧客が片づけたい本当の用件。「何を解決したいか」の出発点。' },
  { num: 2, name: 'シーン',   desc: 'その用件が立ち上がる場面と時間。「どんな状況のときに必要になるか」。' },
  { num: 3, name: '代替案',   desc: '現在使われている解決手段（含：何もしない）。「今、代わりに何をしているか」。' },
  { num: 4, name: '比較軸',   desc: '選ばれるときに使われる判断のものさし。「何で選ぶ・選ばれるか」。' },
  { num: 5, name: '価値',     desc: '比較軸の上で固有に提供できる便益。「なぜ我々が選ばれるか」。' },
  { num: 6, name: '証拠',     desc: '信じてもらうための根拠と数字。「それを裏付けるものは何か」。' },
];

const domains = [
  { num: '①', title: '事業・事業課題をみんどる',
    desc: '事業の見える化をするうえで、何が見えていないかも明確にします。変えるべき部分と、そのままの部分を整理し、社内・事業部内・顧客に対して方向性を共通言語化。どこがズレると成功するのか、どうズレると上手くいかないのか――その構造を把握することで、事業の最大効果が出せる形に導きます。',
    href: '/do-meandle/' },
  { num: '②', title: 'ソリューション・プロダクトをみんどる',
    desc: '競合製品との差別化において、競合にあって自社にない部分を弱みではなく意味として捉え直します。単純な比較ではなく、プロダクトの「個性」をエンドユーザー・バイヤー・ディストリビュータに「強さ」として伝わる形に整えます。',
    href: '/do-meandle/' },
  { num: '③', title: 'Webマーケティング／B2Bマーケティングをみんどる',
    desc: '競合・ベンチマーク・市場背景をみんどり、自社をみんどったものと比較・分析。ブレない方向性をつくり、ブレていく様子自体もみんどっていくことで、どこが成功方程式かを見つけ、成功確率を高めていきます。',
    href: '/get-lead/' },
  { num: '④', title: 'Webコンテンツをみんどる',
    desc: '潜在的なユーザーに正しく届くために、AIがしっかり把握できる形に整えます。必要のない問い合わせを減らし、これまでリーチできていなかった層にも、誤解なく適切に届けることが可能になります。',
    href: '/pr/' },
];

// Sample record (CLOコンパス) — same data as /blog/clo/
const sampleRecord = {
  candidate_name: 'CLOコンパス 物流統括管理者向け意思決定支援ツール',
  must: 'CLO 物流統括管理者向け 全社横断KPI可視化 法令対応レポート自動生成 WMS TMS データ連携 経営意思決定支援',
  scene: '経営戦略立案 改正物流効率化法 定期報告 取締役会 全社KPIダッシュボード',
  examples: 'CLO報告書作成 全社KPIダッシュボード 国交省定期報告 取締役会向け物流改革報告 積載率 荷待ち時間',
  visible_text: 'CLOコンパスは物流を成功に導く 意思決定支援ツール',
  must_not: 'WMS TMS 現場オペレーション 中小企業 運送会社 配送最適化 在庫管理',
};

const presetQueries = [
  { label: 'CLO向け意思決定支援ツール',  type: 'target' },
  { label: '法令対応 レポート 自動生成', type: 'target' },
  { label: 'CLO選任 何から始める',       type: 'target' },
  { label: 'WMS 比較 クラウド',          type: 'noise'  },
  { label: '配送 ルート 最適化',          type: 'noise'  },
  { label: '中小企業 物流管理',           type: 'noise'  },
];

// --- Raw Materials: code blocks (defined as strings so JSX braces don't break) ---

const researchNote = `# Research documentation

  status:       in progress
  organization: ジャグプロジェクト合同会社 (jagproject.com)
  researcher:   Jag Yamamoto

  # 学術引用（BibTeX / APA / IEEE 等の完全な形式）は
  # 研究成果の公式公開後（2027年3月以降）に掲載予定です。

  # このページで開示している数値・実測値は、
  # 進行中の研究および実務検証から得られた参考値です。

  # 特許は出願中（MNDR-2026-001, Pending）。
`;

const reqBefore = `POST /v1/messages
Host: api.anthropic.com
Content-Type: application/json
x-api-key: sk-ant-***
anthropic-version: 2023-06-01

{
  "model": "claude-haiku-4-5-20251001",
  "max_tokens": 512,
  "system": "あなたはB2Bサービスに詳しいアシスタントです。",
  "messages": [{
    "role": "user",
    "content": "以下のサービスについて質問に答えてください。\\n\\n【サービス】CLOコンパス\\n【カテゴリ】物流DXサービス\\n\\n【質問】CLOコンパスはWMSですか？どのような企業に向いていますか？"
  }]
}`;

const resBefore = `200 OK
content-type: application/json

{
  "id": "msg_01Hb...",
  "type": "message",
  "role": "assistant",
  "model": "claude-haiku-4-5-20251001",
  "content": [{
    "type": "text",
    "text": "CLOコンパスは、WMS（倉庫管理システム）ではなく、物流DXプラットフォームです。\\n\\n向いている企業：\\n・中小物流企業・3PL企業：導入・運用負担が少ない\\n・急速に成長中の企業：柔軟なシステム対応が可能..."
  }],
  "stop_reason": "end_turn",
  "usage": { "input_tokens": 417, "output_tokens": 128 }
}`;

const reqAfter = `POST /v1/messages
Host: api.anthropic.com
Content-Type: application/json
x-api-key: sk-ant-***
anthropic-version: 2023-06-01

{
  "model": "claude-haiku-4-5-20251001",
  "max_tokens": 512,
  "system": "あなたはB2Bサービスに詳しいアシスタントです。",
  "messages": [{
    "role": "user",
    "content": "以下のサービスについて質問に答えてください。\\n\\n【サービス】CLOコンパス\\n【カテゴリ】物流DXサービス\\n【みんどりIndex】\\n  must: CLO向け・全社横断KPI可視化・法令対応レポート自動生成・経営意思決定支援\\n  must_not: WMSではない・TMSではない・現場オペレーションではない・中小企業向けではない・運送会社向けではない\\n  examples: CLO報告書作成・全社KPIダッシュボード・国交省定期報告\\n\\n【質問】CLOコンパスはWMSですか？どのような企業に向いていますか？"
  }]
}`;

const resAfter = `200 OK
content-type: application/json

{
  "id": "msg_01Rt...",
  "type": "message",
  "role": "assistant",
  "model": "claude-haiku-4-5-20251001",
  "content": [{
    "type": "text",
    "text": "WMSではありません。CLOコンパスはWMS（倉庫管理システム）ではなく、CLO（物流統括管理者）向けの経営意思決定支援ツールです。\\n\\n向いている企業：大規模荷主企業の経営層・CLOが対象\\n・複数の物流拠点を運営している\\n・改正物流効率化法への対応が必要..."
  }],
  "stop_reason": "end_turn",
  "usage": { "input_tokens": 652, "output_tokens": 194 }
}`;

const schemaJson = `{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id":     "https://meandle.jp/schema/mndr/index/v1.json",
  "title":   "mindori Index",
  "type":    "object",
  "required": ["candidate_name", "must"],
  "properties": {
    "candidate_name":  { "type": "string", "description": "サービス・製品・記事の識別名（必須）" },
    "must":            { "type": "string", "description": "満たされねばならない中核条件（w=2.0）" },
    "must_not":        { "type": "string", "description": "該当したら候補外にする条件（w=-3.0, RSE）" },
    "scene":           { "type": "string", "description": "利用場面・文脈（w=1.5）" },
    "examples":        { "type": "string", "description": "典型例・具体語（w=1.5）" },
    "counterexamples": { "type": "string", "description": "反例・似て非なるもの（w=0.5）" },
    "observation":     { "type": "string", "description": "第三者観察・実証（w=1.2）" },
    "visible_text":    { "type": "string", "description": "既存LPに実際に書かれている文（w=1.0）" }
  },
  "additionalProperties": false
}`;

---
<BaseLayout
  title="How Meandle works — Meandle Theory (MNDR) v1.0｜Meandle"
  description="Meandle Theory (MNDR): field-weighted 2-gram overlap scoring with record-side exclusion (RSE). 数式・アルゴリズム・インタラクティブデモで、みんどりの仕組みを開示します。"
>
  <!-- ── SECTION 1 : Tech Plate ── -->
  <section class="tech-plate-section">
    <div class="container">
      <div class="tech-plate">
        <div class="tech-plate__status" aria-hidden="true">
          <span class="tech-plate__led"></span>
          <span class="tech-plate__status-label">SYSTEM ACTIVE</span>
        </div>
        <div class="tech-plate__row">
          <span class="tech-plate__key">System</span>
          <span class="tech-plate__val">Meandle Theory <span class="tech-plate__accent">(MNDR)</span></span>
          <span class="tech-plate__meta">v1.0</span>
        </div>
        <div class="tech-plate__row">
          <span class="tech-plate__key">Patent</span>
          <span class="tech-plate__val">MNDR-2026-001</span>
          <span class="tech-plate__meta">Pending / 出願中</span>
        </div>
        <div class="tech-plate__row">
          <span class="tech-plate__key">Core</span>
          <span class="tech-plate__val">record-side exclusion <span class="tech-plate__accent">(RSE)</span></span>
          <span class="tech-plate__meta">specification</span>
        </div>
        <div class="tech-plate__row">
          <span class="tech-plate__key">Scoring</span>
          <span class="tech-plate__val">field-weighted 2-gram overlap</span>
          <span class="tech-plate__meta">custom implementation</span>
        </div>
        <div class="tech-plate__row">
          <span class="tech-plate__key">Research</span>
          <span class="tech-plate__val">Jag Yamamoto</span>
          <span class="tech-plate__meta">in progress</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SECTION 2 : Formula Hero ── -->
  <section class="formula-section">
    <div class="container">
      <span class="eyebrow" style="color:var(--hero-orange)">Scoring Formula</span>
      <h1 class="formula-title">意味の届きやすさを、<br/>この 1 式で計算しています。</h1>

      <div class="formula-hero motion-formula" aria-label="スコア計算式">
        <div class="formula-line formula-line--main">
          <span class="tok tok-fn">Score</span><span class="tok tok-pun">(</span><span class="tok tok-var">Q</span><span class="tok tok-pun">,</span> <span class="tok tok-var">X</span><span class="tok tok-pun">)</span> <span class="tok tok-op">=</span>
          <span class="tok tok-op">Σ</span><sub class="tok tok-sub">f ∈ F</sub>
          <span class="tok tok-var">w<sub>f</sub></span> <span class="tok tok-op">·</span>
          <span class="tok tok-fn">overlap</span><sub class="tok tok-sub">2</sub><span class="tok tok-pun">(</span><span class="tok tok-var">Q</span><span class="tok tok-pun">,</span> <span class="tok tok-var">X<sub>f</sub></span><span class="tok tok-pun">)</span>
        </div>
        <div class="formula-line formula-line--sub">
          <span class="formula-indent">　　　　　　　　　</span><span class="tok tok-op tok-neg">−</span> <span class="tok tok-num">3.0</span> <span class="tok tok-op">·</span>
          <span class="tok tok-pun">|</span><span class="tok tok-var">Q</span> <span class="tok tok-op">∩</span> <span class="tok tok-var">X</span><span class="tok tok-pun">.</span><span class="tok tok-key">must_not</span><span class="tok tok-pun">|</span>
        </div>
      </div>

      <dl class="formula-legend">
        <div><dt><code>Q</code></dt>          <dd>クエリ（検索語・AI への問いかけ）</dd></div>
        <div><dt><code>X</code></dt>          <dd>対象レコード（サービス／製品／記事）</dd></div>
        <div><dt><code>F</code></dt>          <dd>{`{ must, examples, scene, candidate_name, visible_text }`}</dd></div>
        <div><dt><code>w<sub>f</sub></code></dt><dd>フィールド重み（下記の重み表）</dd></div>
        <div><dt><code>overlap₂(A,B)</code></dt><dd>2 文字連続（文字バイグラム）集合の共通要素数</dd></div>
        <div><dt><code>must_not</code></dt>  <dd>該当したら減点するフィールド。<strong>record-side exclusion (RSE)</strong> の中核</dd></div>
      </dl>

      <div class="weights-table">
        <table class="compare-table" style="font-family:var(--font-mono); font-size:13.5px">
          <thead>
            <tr><th>フィールド</th><th style="text-align:right">重み w<sub>f</sub></th></tr>
          </thead>
          <tbody>
            <tr><td>must</td>                                <td style="text-align:right">+2.0</td></tr>
            <tr><td>examples / scene / candidate_name</td>   <td style="text-align:right">+1.5</td></tr>
            <tr><td>observation</td>                          <td style="text-align:right">+1.2</td></tr>
            <tr><td>visible_text</td>                         <td style="text-align:right">+1.0</td></tr>
            <tr><td>counterexamples</td>                      <td style="text-align:right">+0.5</td></tr>
            <tr class="highlight"><td>must_not（ペナルティ）</td><td style="text-align:right">−3.0</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ── SECTION 3 : Interactive Scoring Demo ── -->
  <section class="section section--alt" id="demo">
    <div class="container">
      <span class="eyebrow" style="color:var(--hero-orange)">Interactive Demo</span>
      <h2>クエリを入れると、スコアがリアルタイムに動きます。</h2>
      <p>サンプルレコード：<strong>CLOコンパス（物流DX B2Bサービス）</strong>のみんどりIndex。下のプリセット、または自由入力でスコアを試せます。</p>

      <div class="demo" id="scoringDemo">
        <!-- Query input row -->
        <div class="demo-input-wrap">
          <label class="demo-label" for="demoQuery">Query <span class="demo-label__q">Q</span></label>
          <input
            type="text"
            id="demoQuery"
            class="demo-input"
            placeholder="例：CLO向け意思決定支援ツール"
            value="CLO向け意思決定支援ツール"
            autocomplete="off"
          />
        </div>

        <!-- Preset chips -->
        <div class="demo-presets" role="tablist" aria-label="プリセットクエリ">
          {presetQueries.map((p) => (
            <button
              type="button"
              class={`demo-chip demo-chip--${p.type}`}
              data-q={p.label}
            >
              {p.type === 'target' ? '🎯' : '🚫'} {p.label}
            </button>
          ))}
        </div>

        <!-- Bigram tokenization view -->
        <div class="demo-panel">
          <div class="demo-panel__label">
            ① Tokenize（文字バイグラム分解）
            <span class="demo-panel__count"><span id="qCount">0</span> tokens</span>
          </div>
          <div class="demo-bigrams" id="qBigrams" aria-live="polite"></div>
        </div>

        <!-- Per-field overlap -->
        <div class="demo-panel">
          <div class="demo-panel__label">
            ② Field-weighted overlap（フィールド別 一致数 × 重み）
          </div>
          <div class="demo-fields" id="fieldOverlap"></div>
        </div>

        <!-- Total score -->
        <div class="demo-score">
          <div class="demo-score__label">
            ③ Total Score <span class="demo-score__eq">= Σ contributions</span>
          </div>
          <div class="demo-score__bar-track">
            <div class="demo-score__bar" id="scoreBar" style="width:0%"></div>
            <div class="demo-score__bar demo-score__bar--neg" id="scoreBarNeg" style="width:0%"></div>
          </div>
          <div class="demo-score__num" id="scoreNum">0.00</div>
          <div class="demo-score__hint" id="scoreHint">クエリを入力するとスコアが動きます</div>
        </div>

        <!-- Record disclosure -->
        <details class="demo-record">
          <summary>▸ サンプルレコード（CLOコンパスのみんどりIndex）を表示</summary>
          <pre class="demo-record__pre"><code>{JSON.stringify(sampleRecord, null, 2)}</code></pre>
        </details>

        <p class="demo-note">
          ※ 本デモは教育用の簡易実装（正規化を省略した raw 2-gram overlap × field weight）。本実装値（BM25 併用・IDF 補正あり）とは異なりますが、<strong>「なぜ must で加点／must_not で減点されるか」の機構</strong>を可視化する目的です。
        </p>
      </div>
    </div>
  </section>

  <!-- ── SECTION 4 : Algorithm Flow ── -->
  <section class="section">
    <div class="container">
      <span class="eyebrow" style="color:var(--hero-orange)">Algorithm Pipeline</span>
      <h2>1 クエリを、この 5 段で処理します。</h2>

      <div class="algo-flow motion-flow">
        <svg viewBox="0 0 900 220" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="アルゴリズム・フロー図">
          <defs>
            <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="10" markerHeight="10" orient="auto">
              <path d="M0,0 L10,5 L0,10 z" fill="#12242C"/>
            </marker>
          </defs>
          <g font-family="var(--font-mono)" font-size="12" fill="#12242C">
            {[
              { x: 20,  label: '① Input',      sub: 'Query Q' },
              { x: 195, label: '② Tokenize',   sub: '2-gram set' },
              { x: 370, label: '③ Overlap',    sub: '|Q ∩ Xf|' },
              { x: 545, label: '④ Weight',     sub: 'Σ wf · ...' },
              { x: 720, label: '⑤ Penalty',    sub: '− 3.0 · MN' },
            ].map((n, i, arr) => (
              <>
                <rect x={n.x} y="60" width="160" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
                <text x={n.x + 80} y="92" text-anchor="middle" font-size="13" font-weight="700">{n.label}</text>
                <text x={n.x + 80} y="118" text-anchor="middle" font-size="11" fill="#6F7777">{n.sub}</text>
                {i < arr.length - 1 && (
                  <line x1={n.x + 160} y1="100" x2={n.x + 173} y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow)"/>
                )}
              </>
            ))}
            <text x="450" y="30" text-anchor="middle" font-size="14" font-weight="700" fill="#E98F22">Pipeline (RSE-aware)</text>
            <text x="800" y="180" text-anchor="middle" font-size="13" font-weight="700" fill="#12242C">▶ Score</text>
          </g>
        </svg>
      </div>

      <p class="muted" style="font-size:13px; text-align:center; margin-top:8px">
        ⑤ の Penalty ステップが RSE。record 側で「これに触れたら候補から外す」を保持することで、query 側の除外指定なしにミスマッチを構造的に抑制する（特許 MNDR-2026-001 §1）。
      </p>
    </div>
  </section>

  <!-- ── SECTION 5 : (existing) 8 Fields ── -->
  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">Schema</span>
      <h2>意味は、8 つのフィールドで定義できる。</h2>
      <p class="lead">この 8 項目は社内会議用の表ではありません。営業・マーケティング・Web制作・AI検索が同じ意味を扱うための地図です。</p>

      <table style="margin-top:24px">
        <thead><tr><th style="width:25%">フィールド</th><th>説明</th></tr></thead>
        <tbody>
          {eightFields.map((f) => (
            <tr>
              <td><strong>{f.num}. {f.name}</strong></td>
              <td>{f.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="must-card" style="margin-top:24px">
        <h4>7. must</h4>
        <p style="margin-bottom:0">決して外せない約束。文脈の中核。<br/>「これが満たされなければ話にならない条件」。</p>
      </div>
      <div class="must-not-card" style="margin-top:12px">
        <h4>8. must_not</h4>
        <p style="margin-bottom:0">決して該当しない・提供しないこと。<br/>「これに当てはまったら対象外」。<br/>この項目が RSE の入力になります。</p>
      </div>
    </div>
  </section>

  <!-- ── SECTION 6 : (existing) Evidence ── -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Evidence</span>
      <h2>意味を整えると、AIに引き当てられやすくなる。</h2>
      <p>Top-1 正解率（同一クエリ集合に対する、Before/After の比較）</p>
      <div style="max-width:720px; margin-top:20px">
        <div class="evidence-bar evidence-bar--before">
          <span style="min-width:200px">Before（名称のみ）</span>
          <span class="motion-count" data-count-to="63.3" data-decimals="1" data-suffix="%">63.3%</span>
        </div>
        <div class="evidence-bar evidence-bar--after">
          <span style="min-width:200px">After（8フィールド適用）</span>
