    border: 1px solid rgba(18,36,44,0.14);
    border-left: 4px solid var(--hero-orange);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .raw-block__head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 6px;
    padding-bottom: 12px;
    border-bottom: 1px dashed rgba(18,36,44,0.15);
  }
  .raw-badge {
    background: var(--dark);
    color: var(--hero-orange);
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: 3px 8px;
    border-radius: 3px;
  }
  .raw-block__title {
    font-size: 17px;
    font-weight: 700;
    margin: 0;
    flex: 1 1 auto;
  }
  .raw-block__meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .raw-block__meta code {
    background: var(--paper-2);
    padding: 1px 5px;
    font-size: 10.5px;
  }
  .raw-block__lead {
    font-size: 14px;
    color: var(--ink);
    margin: 12px 0 4px;
    line-height: 1.8;
  }
  .raw-block__foot {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px dashed rgba(18,36,44,0.12);
    line-height: 1.8;
  }
  .raw-block__foot code {
    background: var(--paper-2);
    padding: 1px 5px;
    font-size: 12px;
  }

  /* 7.1 API log */
  .raw-log { display: flex; flex-direction: column; gap: 8px; }
  .raw-log__label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    padding: 6px 10px;
    border-radius: 3px 3px 0 0;
    letter-spacing: 0.02em;
    flex-wrap: wrap;
    gap: 6px;
  }
  .raw-log__label--before {
    background: rgba(226,75,74,0.12);
    color: #A32D2D;
    border: 1px solid rgba(226,75,74,0.35);
    border-bottom: none;
  }
  .raw-log__label--after {
    background: rgba(233,143,34,0.14);
    color: var(--ink);
    border: 1px solid rgba(233,143,34,0.45);
    border-bottom: none;
  }
  .raw-log__meta {
    font-weight: 400;
    font-size: 11px;
    color: var(--muted);
  }
  .raw-log__pre {
    font-family: var(--font-mono);
    font-size: 11.5px;
    background: #0E1A20;
    color: #E1E8DC;
    padding: 14px 16px;
    border-radius: 3px;
    overflow-x: auto;
    line-height: 1.7;
    margin: 0;
    white-space: pre;
  }
  .raw-log__pre code { background: transparent; padding: 0; color: inherit; font-size: inherit; }
  .raw-log__pre--req { border-left: 3px solid #6F7777; }
  .raw-log__pre--res { border-left: 3px solid var(--hero-orange); }
  .raw-log__pre--schema { border-left: 3px solid #2A5D8B; margin-top: 12px; }
  .raw-log__pre--cite { border-left: 3px solid var(--muted); font-size: 11px; margin: 0; }
  .raw-log__verdict {
    font-size: 12px;
    font-weight: 700;
    padding: 8px 12px;
    border-radius: 3px;
    line-height: 1.6;
  }
  .raw-log__verdict--fail {
    background: rgba(226,75,74,0.10);
    color: #A32D2D;
    border: 1px solid rgba(226,75,74,0.25);
  }
  .raw-log__verdict--pass {
    background: rgba(233,143,34,0.10);
    color: var(--ink);
    border: 1px solid rgba(233,143,34,0.35);
  }

  /* 7.3 Patent claim */
  .patent-claim {
    margin-top: 12px;
    background: var(--paper);
    border: 1px solid rgba(18,36,44,0.20);
    border-radius: var(--radius);
    overflow: hidden;
    position: relative;
  }
  .patent-claim__head {
    background: linear-gradient(90deg, var(--dark) 0%, #1a2c33 100%);
    color: var(--white);
    padding: 12px 18px;
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-family: var(--font-mono);
  }
  .patent-claim__id {
    color: var(--hero-orange);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .patent-claim__topic {
    color: rgba(255,255,255,0.85);
    font-size: 13px;
    letter-spacing: 0.04em;
  }
  .patent-claim__body {
    padding: 18px 22px;
    font-size: 14px;
    line-height: 1.9;
  }
  .patent-claim__body p { margin-bottom: 10px; }
  .patent-claim__body p:last-child { margin-bottom: 0; }
  .patent-claim__body code {
    background: var(--paper-2);
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .patent-claim__foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 18px;
    background: var(--paper-2);
    border-top: 1px solid rgba(18,36,44,0.12);
    font-size: 11.5px;
    color: var(--muted);
    flex-wrap: wrap;
  }
  .patent-claim__stamp {
    background: #C05B2E;
    color: var(--white);
    padding: 3px 10px;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .patent-claim__note { line-height: 1.6; }

  /* 7.4 Citations */
  .cite-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 14px;
  }
  @media (min-width: 720px) {
    .cite-grid { grid-template-columns: 1fr 1fr; }
  }
  .cite-card {
    background: var(--paper);
    border: 1px solid rgba(18,36,44,0.12);
    border-radius: var(--radius);
    padding: 14px 16px;
  }
  .cite-card__label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--hero-orange);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .cite-card__body {
    font-size: 13.5px;
    line-height: 1.8;
    color: var(--ink);
  }
  .cite-card__body p { margin-bottom: 0; }

  /* ── Section 4: Algorithm flow ── */
  .algo-flow {
    background: var(--card);
    border: 1px solid rgba(18,36,44,0.12);
    border-radius: var(--radius);
    padding: 20px;
    margin: 20px 0 12px;
    box-shadow: var(--shadow);
    overflow-x: auto;
  }
  .algo-flow svg { width: 100%; height: auto; min-width: 720px; display: block; }

  /* ── Ambient motion: Tech Plate (page-specific) ── */
  .tech-plate {
    position: relative;
    overflow: hidden;
  }
  .tech-plate::before {
    content: '';
    position: absolute;
    inset: -30% -10%;
    background: radial-gradient(circle at 20% 40%, rgba(233,143,34,0.10), transparent 55%),
                radial-gradient(circle at 85% 70%, rgba(201,222,220,0.05), transparent 60%);
    animation: platePulse 9s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }
  .tech-plate > * { position: relative; z-index: 1; }
  @keyframes platePulse {
    0%, 100% { transform: scale(1)   translateX(0);   opacity: 0.55; }
    50%      { transform: scale(1.15) translateX(2%); opacity: 1;    }
  }
  .tech-plate__status {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: flex-end;
    padding-bottom: 12px;
    margin-bottom: 4px;
    border-bottom: 1px solid rgba(233,143,34,0.20);
  }
  .tech-plate__led {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px rgba(74,222,128,0.7), 0 0 2px rgba(74,222,128,1);
    animation: ledBlink 2.4s ease-in-out infinite;
  }
  @keyframes ledBlink {
    0%, 40%, 100% { opacity: 1;   transform: scale(1);   }
    45%           { opacity: 0.3; transform: scale(0.85); }
    50%           { opacity: 1;   transform: scale(1);   }
  }
  .tech-plate__status-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: rgba(74,222,128,0.85);
    font-weight: 700;
  }
  @media (prefers-reduced-motion: reduce) {
    .tech-plate::before,
    .tech-plate__led { animation: none !important; }
  }

  /* ── Interactive Demo focus glow ── */
  .demo-input:focus {
    box-shadow: 0 0 0 4px rgba(233,143,34,0.15);
  }
  .demo-chip {
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
  }
  .demo-chip:active { transform: scale(0.96); }
  .demo-score__num {
    transition: color 0.25s ease;
  }
</style>

<script is:inline>
(function () {
  const RECORD = {
    candidate_name: 'CLOコンパス 物流統括管理者向け意思決定支援ツール',
    must:           'CLO 物流統括管理者向け 全社横断KPI可視化 法令対応レポート自動生成 WMS TMS データ連携 経営意思決定支援',
    scene:          '経営戦略立案 改正物流効率化法 定期報告 取締役会 全社KPIダッシュボード',
    examples:       'CLO報告書作成 全社KPIダッシュボード 国交省定期報告 取締役会向け物流改革報告 積載率 荷待ち時間',
    visible_text:   'CLOコンパスは物流を成功に導く 意思決定支援ツール',
    must_not:       'WMS TMS 現場オペレーション 中小企業 運送会社 配送最適化 在庫管理',
  };

  const FIELDS = [
    { key: 'must',           weight: 2.0, label: 'must' },
    { key: 'examples',       weight: 1.5, label: 'examples' },
    { key: 'scene',          weight: 1.5, label: 'scene' },
    { key: 'candidate_name', weight: 1.5, label: 'candidate_name' },
    { key: 'visible_text',   weight: 1.0, label: 'visible_text' },
  ];
  const MUST_NOT_PENALTY = -3.0;

  // Pre-compute record bigrams
  function bigrams(text) {
    if (!text) return new Set();
    const clean = text.replace(/[\s　]+/g, '');
    const set = new Set();
    for (let i = 0; i < clean.length - 1; i++) {
      set.add(clean.substring(i, i + 2));
    }
    return set;
  }
  const RECORD_GRAMS = {};
  for (const k of Object.keys(RECORD)) RECORD_GRAMS[k] = bigrams(RECORD[k]);

  const $q         = document.getElementById('demoQuery');
  const $qBigrams  = document.getElementById('qBigrams');
  const $qCount    = document.getElementById('qCount');
  const $fields    = document.getElementById('fieldOverlap');
  const $scoreBar  = document.getElementById('scoreBar');
  const $scoreNeg  = document.getElementById('scoreBarNeg');
  const $scoreNum  = document.getElementById('scoreNum');
  const $scoreHint = document.getElementById('scoreHint');
  if (!$q) return;

  // Pre-build the fields DOM
  const rows = {};
  FIELDS.concat([{ key: 'must_not', weight: MUST_NOT_PENALTY, label: 'must_not' }]).forEach((f) => {
    const row = document.createElement('div');
    row.className = 'demo-field-row';
    const isNeg = f.weight < 0;
    row.innerHTML = `
      <span class="demo-field-name">${f.label}</span>
      <span class="demo-field-weight${isNeg ? ' is-neg' : ''}">${isNeg ? '−' : '+'}${Math.abs(f.weight).toFixed(1)}</span>
      <div class="demo-field-bar-track"><div class="demo-field-bar${isNeg ? ' is-neg' : ''}" data-bar style="width:0%"></div></div>
      <span class="demo-field-contrib is-zero" data-contrib>0.00</span>
    `;
    $fields.appendChild(row);
    rows[f.key] = row;
  });

  const SCORE_MAX_ABS = 12; // for bar scaling

  function compute(query) {
    const qGrams = bigrams(query);
    const contribs = {};
    let total = 0;
    let posSum = 0;
    let mustNotHits = new Set();

    // Positive fields
    for (const f of FIELDS) {
      const common = new Set();
      for (const g of qGrams) if (RECORD_GRAMS[f.key].has(g)) common.add(g);
      const c = f.weight * common.size;
      contribs[f.key] = { common, count: common.size, contribution: c };
      total += c;
      posSum += c;
    }
    // must_not penalty
    for (const g of qGrams) if (RECORD_GRAMS.must_not.has(g)) mustNotHits.add(g);
    const penalty = MUST_NOT_PENALTY * mustNotHits.size;
    contribs.must_not = { common: mustNotHits, count: mustNotHits.size, contribution: penalty };
    total += penalty;

    return { qGrams, contribs, total, penalty };
  }

  function render(query) {
    const { qGrams, contribs, total, penalty } = compute(query);

    // Compute which qGrams matched any positive field vs must_not
    const posMatched = new Set();
    for (const f of FIELDS) for (const g of contribs[f.key].common) posMatched.add(g);
    const negMatched = contribs.must_not.common;

    // Bigram tokens display
    $qCount.textContent = qGrams.size;
    $qBigrams.innerHTML = '';
    if (qGrams.size === 0) {
      $qBigrams.innerHTML = '<span style="font-size:12px; color:var(--muted)">（クエリを入力してください）</span>';
    } else {
      for (const g of qGrams) {
        const el = document.createElement('span');
        el.className = 'bigram';
        if (negMatched.has(g)) el.classList.add('is-matched-neg');
        else if (posMatched.has(g)) el.classList.add('is-matched');
        el.textContent = g;
        $qBigrams.appendChild(el);
      }
    }

    // Per-field bars
    const maxContribAbs = Math.max(1, ...Object.values(contribs).map(c => Math.abs(c.contribution)));
    for (const f of FIELDS.concat([{ key: 'must_not' }])) {
      const row = rows[f.key];
      const c = contribs[f.key];
      const bar = row.querySelector('[data-bar]');
      const cn = row.querySelector('[data-contrib]');
      const pct = Math.min(100, (Math.abs(c.contribution) / maxContribAbs) * 100);
      bar.style.width = pct + '%';
      cn.textContent = (c.contribution >= 0 ? '+' : '') + c.contribution.toFixed(2);
      cn.classList.toggle('is-zero', c.contribution === 0);
      cn.classList.toggle('is-neg', c.contribution < 0);
    }

    // Total score bar
    $scoreNum.textContent = (total >= 0 ? '+' : '') + total.toFixed(2);
    $scoreNum.style.color = total >= 0 ? 'var(--hero-orange)' : '#E24B4A';
    const posPct = Math.min(50, (Math.max(0, total) / SCORE_MAX_ABS) * 50);
    const negPct = Math.min(50, (Math.abs(Math.min(0, total)) / SCORE_MAX_ABS) * 50);
    $scoreBar.style.width = posPct + '%';
    $scoreNeg.style.width = negPct + '%';

    // Hint
    if (qGrams.size === 0) {
      $scoreHint.textContent = 'クエリを入力するとスコアが動きます';
    } else if (total > 3) {
      $scoreHint.textContent = '🎯 このクエリは正しく届く（候補として上位に来る）';
    } else if (total < -0.5) {
      $scoreHint.textContent = '🚫 must_not が発動：このクエリには推薦されない（意図した挙動）';
    } else if (total > 0) {
      $scoreHint.textContent = '△ 弱いマッチ（もう少しレコード側の文脈を厚くする余地あり）';
    } else {
      $scoreHint.textContent = '～ ほぼ関係なし。境界の外側のクエリ';
    }
  }

  // Wire events
  $q.addEventListener('input', (e) => render(e.target.value));
  document.querySelectorAll('.demo-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      $q.value = btn.dataset.q;
      render(btn.dataset.q);
    });
  });

  // Initial render
  render($q.value);
})();
</script>

