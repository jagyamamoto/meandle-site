  @media (max-width: 640px) {
    .demo-field-row { grid-template-columns: 96px 50px 1fr 60px; font-size: 11.5px; }
  }
  .demo-field-name { color: var(--ink); font-weight: 600; }
  .demo-field-weight { color: var(--muted); text-align: right; }
  .demo-field-weight.is-neg { color: #C05B2E; font-weight: 700; }
  .demo-field-bar-track {
    background: var(--paper-2);
