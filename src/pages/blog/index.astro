---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    slug: 'temperature-sensing-ink',
    title: '温度×時間センシングインクは、検索とLLMに「しっかり届く」か',
    subtitle: '日立産機システムのPRリリースをサンプルに、名称だけの露出と、meandle式iフレームで文脈化した露出の差を、文字バイグラムoverlapで検証する実験記事',
    category: '仮説シミュレーション',
    date: '2026-05-26',
  },
];
---
<BaseLayout
  title="Self Do.meandle - 検証ノート｜Meandle"
  description="Meandleを使った検証事例を、1記事1テーマで公開します。"
>
  <section class="section">
    <div class="container container--narrow">
      <nav class="breadcrumb"><a href="/">ホーム</a>　/　Blog</nav>
      <span class="eyebrow">Self Do.meandle</span>
      <h1>Self Do.meandle - 検証ノート</h1>
      <p class="lead">Meandleを使った検証事例を、1記事1テーマで公開します。<br/>自社の商材、求人、PRに置き換えて読めるよう、<br/>結果だけでなく方法も残します。</p>

      <div style="display:grid; gap:18px; margin-top:48px">
        {posts.map((p) => (
          <a class="service-card" href={`/blog/${p.slug}/`}>
            <div style="display:flex; gap:10px; align-items:center; font-size:12px; margin-bottom:10px">
              <span class="badge">{p.category}</span>
              <span style="color:var(--muted); margin-left:auto">{p.date}</span>
            </div>
            <h3>{p.title}</h3>
            <p style="color:var(--muted); font-size:14px">{p.subtitle}</p>
            <span>記事を読む →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
