---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    slug: 'temperature-sensing-ink',
    title: '温度×時間センシングインクは、検索とLLMに「しっかり届く」か',
    subtitle: '日立産機システムのPRリリースをサンプルに、名称だけの露出と、meandle式iフレームで文脈化した露出の差を、文字バイグラムoverlapで検証する実験記事',
    category: '仮説シミュレーション',
    date: '2026-05-26',
  },
];
---
<BaseLayout
  title="Self Do.meandle - 検証ノート｜Meandle"
  description="Meandleチームが実際のソリューション・サービス・商品を対象に、みんどり最適化を実施。その前後のみんどりスコア変化・AIマッチング状況の変化・実際に出てきた問い合わせ変化などをリアルに公開します。"
>
  <section class="hero">
    <div class="container">
      <span class="eyebrow hero__eyebrow">Self Do.meandle</span>
      <h1 class="hero-copy">Meandleチームが<br/>「生きた実験場」をお見せします</h1>
      <p style="margin-top:24px">Meandleチームが実際のソリューション・サービス・商品を対象に、みんどり最適化を実施。その<strong>前後のみんどりスコア変化・AIマッチング状況の変化・実際に出てきた問い合わせ変化</strong>などをリアルに公開します。</p>
      <p>「本当に効果があるのか？」「どのくらいの期間で変化するのか？」<br/>そんな疑問に、実験データで答えます。</p>
      <div class="hero__badges">
        <span class="badge">検証実例</span>
        <span class="badge">みんどりスコア変化</span>
        <span class="badge">AIO・Perplexity・ChatGPT推薦率</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div style="display:grid; gap:18px">
        {posts.map((p) => (
          <a class="service-card" href={`/blog/${p.slug}/`}>
            <div style="display:flex; gap:10px; align-items:center; font-size:12px; margin-bottom:10px">
              <span class="badge">{p.category}</span>
              <span style="color:var(--muted); margin-left:auto">{p.date}</span>
            </div>
            <h3>{p.title}</h3>
            <p style="color:var(--muted); font-size:14px">{p.subtitle}</p>
            <span>記事を読む →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
