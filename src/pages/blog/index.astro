---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Blog｜検証ノートと購入前ガイド｜Meandle';
const description = 'AI検索の観測、条件付きLLM応答テスト、意味設計、支援会社の選び方などを整理した検証ノートと購入前ガイドです。成果を約束するものではありません。';

const articles = [
  {
    slug: 'chatgpt-company-not-found',
    title: 'ChatGPTで自社名・商材が出ないとき、最初に分ける4つの確認',
    excerpt: '「出ない」を一つの原因にせず、公開・アクセス条件、事実の整合、意味仕様、外部環境を分けて確認するための記事。',
    tag: '購入前ガイド',
  },
  {
    slug: 'ai-misinformation-misrecommendation',
    title: '誤認と誤推薦を、同じ問題として扱わない。',
    excerpt: 'AIによる事実誤りと、対象外の相手への誤推薦は別の問題。高単価B2Bの対象・価値・根拠・対象外条件を意味仕様にする考え方。',
    tag: '購入前ガイド',
  },
  {
    slug: 'how-to-choose-ai-search-support',
    title: 'AIO・LLMO・GEO支援の選び方：費用より先に、責任範囲を分ける',
    excerpt: '呼び方ではなく、観測から実装までのどこを誰が担うかで選ぶためのガイド。5範囲・7質問・費用の読み方。',
    tag: '購入前ガイド',
  },
  {
    slug: 'monitoring-to-implementation',
    title: '観測した後、ページの何をどう直すか。',
    excerpt: 'AIO／GEOの観測結果を、対象・対象外・価値・根拠の意味仕様、実装差分、優先1ページ実装、初回比較記録へつなぐ責任の鎖。',
    tag: '実装ガイド',
  },
  {
    slug: 'clo',
    title: '同一質問に、異なる情報を与えると何が変わるか：条件付きLLM応答テストの設計ノート',
    excerpt: '条件付き応答テスト（CLO＝作業ラベル）の方法と限界。公開WebやAI検索の効果を示すものではありません。',
    tag: '検証ノート',
  },
  {
    slug: 'temperature-sensing-ink',
    title: '温度×時間センシングインクは、検索とLLMに「しっかり届く」か',
    excerpt: '公開PRリリースをサンプルに、名称だけの露出と文脈化した露出の差を文字バイグラム照合で比べた仮説シミュレーション（自主実験）。実測ではありません。',
    tag: '検証ノート',
  },
  {
    slug: 'hitachi',
    title: '温度×時間センシングインクは、AIに「食べ頃予測の技術」として届くか',
    excerpt: '同サンプルに文脈と境界（must_not）を加えた場合のスコア変化を確認した仮説シミュレーション第2回（自主実験）。設計上の比較であり、実際の検索順位やLLM評価の測定ではありません。',
    tag: '検証ノート',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://meandle.jp/blog/#webpage',
    url: 'https://meandle.jp/blog/',
    name: title,
    description: description,
    isPartOf: { '@id': 'https://meandle.jp/#website' },
    inLanguage: 'ja-JP',
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="/blog/"
  ogTitle={title}
  ogDescription={description}
  structuredData={structuredData}
>
  <section class="hero hero--split">
    <div class="hero__bg-grid" aria-hidden="true"></div>
    <div class="hero__bg-noise" aria-hidden="true"></div>
    <div class="container">
      <nav class="breadcrumb"><a href="/">ホーム</a>　/　Blog</nav>
      <span class="eyebrow hero__eyebrow">Meandle Notes</span>
      <h1 class="hero-copy">検証ノートと購入前ガイド</h1>
      <p class="lead" style="margin-top:20px">
        AI検索の観測、条件付きLLM応答テスト、意味設計、支援会社の選び方などを整理したノートです。<br/>
        AI応答、引用、順位、流入、商談、売上を約束するものではありません。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div class="grid grid--2 mt-3">
        {articles.map((article) => (
          <a href={`/blog/${article.slug}/`} class="service-card">
            <div class="eyebrow" style="color:var(--hero-orange); margin-bottom:6px">{article.tag}</div>
            <h3>{article.title}</h3>
            <p style="font-size:14px; margin:10px 0">{article.excerpt}</p>
            <span>読む →</span>
          </a>
        ))}
      </div>

      <div class="callout-note" style="margin-top:32px">
        すべての記事は、Meandleの設計方針（E0）または一次情報の整理として書かれています。実在案件のBefore／Afterや成果は、証拠台帳と許諾が揃った場合にだけ公開します。
      </div>
    </div>
  </section>

  <section class="cta-block">
    <div class="container container--narrow">
      <span class="eyebrow" style="color:var(--hero-orange)">Start with One URL</span>
      <h2>既存URLで導入適合性を確認する。</h2>
      <p>初回は、1商材・1URLの意味適合スプリント 50万円〜です。</p>
      <a href="/contact/" class="btn btn--primary" style="margin-top:16px">既存URLで導入適合性を確認する</a>
    </div>
  </section>
</BaseLayout>
