const description = 'ChatGPT等で自社名・商材が出ない、説明が合わないと感じたときの確認順。公開・アクセス条件、事実の整合、意味仕様、外部環境を分けて整理します。';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://meandle.jp/blog/chatgpt-company-not-found/#webpage',
    url: 'https://meandle.jp/blog/chatgpt-company-not-found/',
    name: title,
    description: description,
    inLanguage: 'ja-JP',
    isPartOf: { '@id': 'https://meandle.jp/#website' },
    about: { '@id': 'https://meandle.jp/do-meandle/#service' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': 'https://meandle.jp/blog/chatgpt-company-not-found/#article',
    mainEntityOfPage: { '@id': 'https://meandle.jp/blog/chatgpt-company-not-found/#webpage' },
    headline: 'ChatGPTで自社名・商材が出ないとき、最初に分ける4つの確認',
    description: description,
    image: 'https://meandle.jp/images/blog/chatgpt-company-not-found/hero-v1.webp',
