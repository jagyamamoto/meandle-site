<script is:inline>
(function () {
  const reader = document.getElementById('comicReader');
  if (!reader) return;
  const track = document.getElementById('comicTrack');
  const slides = track.querySelectorAll('.comic-slide');
  const pages = reader.querySelectorAll('.comic-page');
  const navs = reader.querySelectorAll('.comic-nav');
  if (!slides.length) return;
  const total = slides.length;
  let current = 0;

  function scrollToIndex(i) {
    const idx = Math.max(0, Math.min(total - 1, i));
    const target = slides[idx];
    if (!target) return;
    // Use scrollLeft for precision (offsetLeft is relative to scrolling parent)
    const targetLeft = target.offsetLeft - track.offsetLeft;
    track.scrollTo({ left: targetLeft, behavior: 'smooth' });
  }

  function getCurrent() {
    const trackRect = track.getBoundingClientRect();
    const center = trackRect.left + trackRect.width / 2;
    let closest = 0, minDist = Infinity;
    slides.forEach((s, i) => {
      const r = s.getBoundingClientRect();
      const d = Math.abs(r.left + r.width / 2 - center);
      if (d < minDist) { minDist = d; closest = i; }
    });
    return closest;
  }

  function update() {
    current = getCurrent();
    pages.forEach((p, i) => {
      const active = i === current;
      p.classList.toggle('is-active', active);
      if (active) {
        p.setAttribute('aria-current', 'true');
      } else {
        p.removeAttribute('aria-current');
      }
    });
    navs.forEach((btn) => {
      const dir = parseInt(btn.dataset.dir, 10);
      if (dir === -1) btn.disabled = current === 0;
      if (dir === 1)  btn.disabled = current === total - 1;
    });
  }

  navs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const dir = parseInt(btn.dataset.dir, 10);
      scrollToIndex(current + dir);
    });
  });

  pages.forEach((p) => {
    p.addEventListener('click', () => {
      scrollToIndex(parseInt(p.dataset.i, 10));
    });
  });

  let scrollTimer = null;
  track.addEventListener('scroll', () => {
    if (scrollTimer) clearTimeout(scrollTimer);
    scrollTimer = setTimeout(update, 80);
  });

  reader.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); scrollToIndex(current + 1); }
    if (e.key === 'ArrowLeft')  { e.preventDefault(); scrollToIndex(current - 1); }
    if (e.key === 'Home')       { e.preventDefault(); scrollToIndex(0); }
    if (e.key === 'End')        { e.preventDefault(); scrollToIndex(total - 1); }
  });

  // Re-evaluate on resize (panel widths change)
  window.addEventListener('resize', () => {
    scrollToIndex(current);
  });

  update();
})();
</script>
