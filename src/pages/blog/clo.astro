const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://meandle.jp/blog/clo/#webpage',
    url: 'https://meandle.jp/blog/clo/',
    name: title,
    description: description,
    inLanguage: 'ja-JP',
    isPartOf: { '@id': 'https://meandle.jp/#website' },
    about: { '@id': 'https://meandle.jp/do-meandle/#service' },
  },
  {
    '@context': 'https://schema.org',
