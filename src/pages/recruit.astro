---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Meandle recruit｜転職エージェントに頼む前に、求人票の意味を整える｜Meandle';
const description = '3名採用の参考試算：転職エージェント450〜525万円に対し、Meandle recruitは3職種150万円。前提を明示した試算であり、採用成果を保証するものではありません。求人票をみんどりIndexの形に構造化し、AIと候補者に拾われやすい形へ整えます。';
const ogTitle = '転職エージェントに頼む前に、求人票の意味を整える｜Meandle recruit';
const ogDescription = '採用コストの多くは、求人票が求める人に伝わっていない状態を人手で補う費用です。1求人項目50万円〜。';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://meandle.jp/recruit/#webpage',
    url: 'https://meandle.jp/recruit/',
    name: title,
    description: description,
    inLanguage: 'ja',
    isPartOf: { '@id': 'https://meandle.jp/#website' },
    about: { '@id': 'https://meandle.jp/recruit/#service' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': 'https://meandle.jp/recruit/#service',
    name: 'Meandle recruit',
    serviceType: 'B2B意味設計 / 求人情報の意味整合',
    url: 'https://meandle.jp/recruit/',
    description: '求人の対象・活躍場面・期待・対象外条件を意味仕様にし、求人ページへ反映するサービスです。1求人項目50万円〜。採用成果を保証しません。',
    provider: { '@id': 'https://meandle.jp/#organization' },
    areaServed: 'JP',
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="/recruit/"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  structuredData={structuredData}
>
  <!-- Section 1: Hero -->
  <section class="hero hero--split">
    <div class="hero__bg-grid" aria-hidden="true"></div>
    <div class="hero__bg-noise" aria-hidden="true"></div>
    <div class="container">
      <nav class="breadcrumb"><a href="/">ホーム</a>　/　Meandle recruit</nav>
      <div class="hero__split">
        <div class="hero__left">
          <span class="eyebrow hero__eyebrow">Meandle recruit</span>
          <h1 class="hero-copy">転職エージェントに頼む前に、<br/>求人票の意味を整える。</h1>
          <p class="lead" style="margin-top:20px">
            採用コストが高くなる大きな理由は、<strong>求める人材像が求人票から正確に伝わっていない</strong>ことです。伝わらない分を、紹介フィーとスクリーニング工数という外部の人手で補うことになります。
          </p>
          <p>
            Meandle recruitは、求人ページを<strong>みんどりIndexの形に構造化</strong>し、求める人物像をAIと候補者に拾われやすい形へ整えます。1求人項目50万円〜。応募数や採用成果を保証するものではありません。
          </p>

          <p style="margin-top:16px"><strong>1求人項目 50万円〜｜3職種一括 150万円</strong></p>

          <div class="hero__cta-group">
            <a href="/contact/" class="btn btn--primary">難航している求人で適合性を確認する</a>
          </div>
          <p style="font-size:13px; color:var(--muted); margin-top:12px">
            求人ページのURL、求める人物像、対象外にしたい応募をお知らせください。
          </p>
        </div>

        <aside class="proof-panel" aria-label="採用コスト試算 ライブ表示">
          <div class="proof-panel__head">
            <span class="proof-panel__led"></span>
            <span class="proof-panel__label">COST&nbsp;SIMULATION</span>
            <span class="proof-panel__timer"></span>
          </div>
          <div class="proof-stage">
            <div class="proof-slide is-active">
              <div class="proof-slide__type">💰 3名採用の場合 コスト削減試算</div>
              <div class="proof-slide__num"><span class="proof-num" data-count-to="375">375</span><span class="proof-slide__unit">万円削減（試算）</span></div>
              <div class="proof-slide__name">エージェント525万 → Meandle 150万</div>
              <div class="proof-slide__body">年収500万円の人材×3名の参考試算。フィー率30〜35%を試算の前提に置いた場合の比較です。<strong>同等の採用成果を保証するものではありません。</strong></div>
              <div class="proof-slide__query">SIMULATION · 前提：フィー30〜35%</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">🔴 従来手法：転職エージェント</div>
              <div class="proof-slide__num"><span class="proof-num" data-count-to="525">525</span><span class="proof-slide__unit">万円（試算上限）</span></div>
              <div class="proof-slide__name">3名採用時のフィー試算</div>
              <div class="proof-slide__body">1名あたり150〜175万円（年収500万円×フィー率30〜35%の前提）。ミスマッチで早期退職しても費用は発生し、やり直しでコストが積み上がる構造です。</div>
              <div class="proof-slide__query">SIMULATION · 1名 150〜175万円</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">🟠 Meandle recruit：3職種一括</div>
              <div class="proof-slide__num"><span class="proof-num" data-count-to="150">150</span><span class="proof-slide__unit">万円</span></div>
              <div class="proof-slide__name">求人3職種の意味設計</div>
              <div class="proof-slide__body">求人ページを<strong>みんどりIndex化</strong>し、求める人・求めない人が判断できる形へ。1職種50万円×3の提供価格です。</div>
              <div class="proof-slide__query">1職種 50万円 × 3</div>
            </div>
          </div>
          <div class="proof-panel__dots">
            <button class="proof-dot is-active" data-i="0" aria-label="削減額"></button>
            <button class="proof-dot" data-i="1" aria-label="従来手法"></button>
            <button class="proof-dot" data-i="2" aria-label="Meandle recruit"></button>
          </div>
        </aside>
      </div>

      <div class="hero-marquee" aria-hidden="true">
        <div class="hero-marquee__track">
          <span class="hero-marquee__lead">◉ COST SIMULATION</span>
          <span>▸ 3-hire saving: −375万円（試算）</span>
          <span>▸ 前提：エージェントフィー 30〜35%</span>
          <span>▸ Meandle recruit 50万/求人項目</span>
          <span>▸ no hiring-result guarantees</span>
          <span>▸ patent pending</span>
          <span class="hero-marquee__lead">◉ COST SIMULATION</span>
          <span>▸ 3-hire saving: −375万円（試算）</span>
          <span>▸ 前提：エージェントフィー 30〜35%</span>
          <span>▸ Meandle recruit 50万/求人項目</span>
          <span>▸ no hiring-result guarantees</span>
          <span>▸ patent pending</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Cost Simulation -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Cost Simulation</span>
      <h2>採用コスト比較シミュレーション</h2>
      <span class="ev-badge ev-badge--sim">⚠ SIMULATION — 参考試算値</span>

      <div class="sim-box">
        <span class="sim-label">前提：年収500万円の人材を3名採用する場合。エージェントフィー率は30〜35%を試算の前提に置いています。</span>

        <div class="table-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th>手法</th>
                <th>費用（試算）</th>
                <th>構造上の課題</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>転職エージェント</td>
                <td>150〜175万円/人<br/>3名で450〜525万円</td>
                <td>ミスマッチで早期退職しても費用が発生する</td>
              </tr>
              <tr>
                <td>求人広告（Indeed等）</td>
                <td>3〜30万円/月＋社内工数</td>
                <td>合わない応募が多く、スクリーニング工数がかかる</td>
              </tr>
              <tr class="highlight">
                <td><strong>Meandle recruit</strong></td>
                <td><strong>50万円/求人項目<br/>3職種で150万円</strong></td>
                <td>求人票の意味を整え、合わない応募の発生源を減らす</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="fact-bar fact-bar--highlight" style="margin-top:14px">
          <span class="fact-bar__icon">💡</span>
          <div>試算：エージェント3名採用（525万円）に対し、Meandle recruit 3職種（150万円）は<strong>375万円のコスト削減</strong>の試算になります。ミスマッチ減による採用やり直しコストの低減も見込む試算です。</div>
        </div>

        <div class="sim-disclaimer">
          ※ 採用1名あたりコストは職種・業種・市場により大幅に変動します。フィー率30〜35%は当試算の前提として置いた値です。試算は参考値であり、同等の採用成果・コスト削減を保証するものではありません。
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: What is done -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">What We Do</span>
      <h2>求人票を、求める人が判断できる意味の形に構造化します。</h2>
      <p>職種名、業務リスト、待遇だけの求人は、同じ職種名のあらゆる仕事と同じに見えます。Meandle recruitは、1求人項目ごとに次を定め、求人ページへ反映します。</p>

      <div class="table-wrap mt-3">
        <table class="compare-table">
          <thead><tr><th scope="col">項目</th><th scope="col">求人で決めること</th><th scope="col">反映先</th></tr></thead>
          <tbody>
            <tr><td>役割</td><td>この仕事は、事業の何を担うか</td><td>求人タイトル、冒頭</td></tr>
            <tr><td>活躍場面</td><td>どの状況で、誰と、何を判断する仕事か</td><td>仕事内容、1日の流れ</td></tr>
            <tr><td>期待</td><td>入社後に任せる仕事と、期待する変化</td><td>ミッション、評価の説明</td></tr>
            <tr><td>根拠</td><td>働き方や環境の説明を裏付ける事実</td><td>制度、実例、数値と出典</td></tr>
            <tr><td>必須条件</td><td>応募に必要な経験・状況</td><td>応募要件</td></tr>
            <tr><td>対象外条件</td><td>この求人で扱わない仕事、合わない希望</td><td>応募要件、FAQ</td></tr>
          </tbody>
        </table>
      </div>

      <p style="margin-top:16px">この構造（みんどりIndex）が、求人ページ、媒体原稿、エージェントへの依頼内容をそろえる共通の仕様になります。運用は月次で継続改善できます。</p>

      <div class="callout-note">
        <strong>含まれないこと：</strong>求人媒体の運用代行、スカウト送信、応募者対応、選考代行は含みません。応募数、採用数、採用成果、掲載順位は保証しません。
      </div>
    </div>
  </section>

  <!-- Section 4: Pricing -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Pricing</span>
      <h2>料金</h2>
      <div class="price-card">
        <div class="price-label">Meandle recruit</div>
        <div class="price">¥500,000<span class="price-unit">〜 /求人項目</span></div>
        <div class="price-note">求人ページのみんどりIndex構造化＋コンテンツ最適化＋人事PR設計一式。複数職種は項目ごとに設計します（3職種一括150万円）。</div>
      </div>
      <div class="callout-note">
        表示価格は下限です。対象職種数、事実確認、反映範囲により個別に設計します。応募数や採用成果を保証するものではありません。
      </div>
    </div>
  </section>

  <!-- Section 5: Fit -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">Fit Before Spend</span>
      <h2>向いている求人と、別の施策が合理的な求人があります。</h2>
      <div class="grid grid--2 mt-4">
        <div>
          <h3 style="color:var(--hero-orange)">向いている求人</h3>
          <ul>
            <li>専門性が高く、職種名だけでは仕事の中身が伝わらない</li>
            <li>応募は来るが、求める経験・状況と合わない応募が多い</li>
            <li>採用1名あたりの費用とミスマッチの損失が大きい</li>
            <li>仕事内容と働き方の事実確認に、現場と人事が協力できる</li>
          </ul>
        </div>
        <div>
          <h3 style="color:var(--muted)">別の施策が合理的な求人</h3>
          <ul>
            <li>とにかく短期間で多くの母集団が必要（求人広告・エージェントの活用が合理的です）</li>
            <li>採用条件・仕事内容がまだ社内で決まっていない</li>
            <li>応募数や採用数の保証を前提としている</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: Final -->
  <section class="cta-block">
    <div class="container container--narrow">
      <span class="eyebrow" style="color:var(--hero-orange)">Start with One Job Post</span>
      <h2>いま難航している求人を、1つ教えてください。</h2>
      <p>求人ページのURL、求める人物像、対象外にしたい応募を確認し、Meandle recruitで扱うべき課題かをお返しします。適合する場合に、1求人項目50万円〜の進め方をご案内します。</p>
      <a href="/contact/" class="btn btn--primary" style="margin-top:20px">難航している求人で適合性を確認する</a>
      <p style="color:rgba(255,255,255,0.75); font-size:13px; margin-top:12px">
        応募数、採用数、採用成果、掲載順位を保証するものではありません。
      </p>
      <p style="color:rgba(255,255,255,0.65); font-size:12px; margin-top:20px">
        Meandleは、Jag Yamamoto / Jag Projectが開発・監修するB2B意味設計ソリューションです。<br/>
        運営元：<a href="https://jagproject.com/" target="_blank" rel="noopener" style="color:var(--hero-orange)">jagproject.com ↗</a>
      </p>
    </div>
  </section>
</BaseLayout>
