---
import BaseLayout from '../layouts/BaseLayout.astro';
import nav from '../data/navigation.json';
import ThreeStepFlow from '../components/ThreeStepFlow.astro';
import CompareSimulator from '../components/CompareSimulator.astro';
import MindoriMeter from '../components/MindoriMeter.astro';
import FAQCard from '../components/FAQCard.astro';

const services = nav.services;

const faqs = [
  { q: 'MeandleはSEO対策ですか。', a: 'SEOだけではありません。検索順位を直接保証するサービスではなく、商品、PR、求人の意味を整理し、AIと顧客に誤解されにくいページへ整えるサービスです。' },
  { q: '既存ページでも使えますか。', a: 'はい。既存URLをもとに診断し、must、must_not、典型例、反例を整理します。必要に応じてLPやFAQも修正します。' },
  { q: '成果は保証されますか。', a: '保証はしません。みんどり値、比較シミュレーション、改善前後の構造差を示し、商談化や応募の可能性を高めるための設計を行います。' },
  { q: 'どのサービスから始めるべきですか。', a: '既存の商品ページがある場合はdo.meandle、広告や資料請求費を見直したい場合はMeandle get lead、新製品の訴求ならMeandle PR、採用ならMeandle recruitから始めます。' },
  { q: '「みんどる」とは何ですか。', a: '対象の意味を、必須条件、除外条件、典型例、反例などに分けて構造化することです。正式な名前がない価値や、誤解されやすい商材を扱うための方法です。' },
];
---
<BaseLayout>

  <!-- 1. Hero -->
  <section class="hero">
    <div class="container">
      <span class="eyebrow">B2B Meaning Design / Meandle</span>
      <h1>広告費を増やす前に、<br/>AIと見込み客が拾える<br class="d-sp"/>「<span style="color:var(--accent)">売る意味</span>」を整える。</h1>
      <p class="lead">Meandleは、専門商材、PR、求人票の内容を、AIと見込み客に誤解されにくい形へ整えるサービスです。既存URLを診断し、みんどり値で改善点を見える化します。</p>
      <div class="flex-row">
        <a href="/contact/" class="btn btn--lg">既存URLで診断する</a>
        <a href="#simulate" class="btn btn--ghost btn--lg">費用対効果を試算する</a>
      </div>
      <div class="badges">
        <span class="badge badge--accent">既存URLから開始</span>
        <span class="badge badge--accent">みんどり値で可視化</span>
        <span class="badge badge--warn">特許出願関連技術</span>
        <span class="badge">BtoB支援実績あり</span>
      </div>
    </div>
  </section>

  <!-- 2. 悩み -->
  <section class="section section--alt">
    <div class="container container--narrow center">
      <span class="eyebrow">Symptom</span>
      <h2>広告、資料請求、求人媒体。<br/>増やすほど、ズレも増えていませんか。</h2>
      <p class="lead">予算を増やしても、商談化率は上がらない。<br/>応募は来るが、ミスマッチが減らない。<br/>その原因は、量ではなく、ページ側の「意味の作り」にあります。</p>
    </div>
  </section>

  <!-- 3. 解決 -->
  <section class="section">
    <div class="container container--narrow center">
      <span class="eyebrow">Approach</span>
      <h2>意味を分ける。ズレを消す。<br/>AIに拾われる形にする。</h2>
      <p class="lead">Meandle は、ページの中の「言うべきこと」と「決して誤解されたくないこと」を、別の項目として整理します。AI も見込み客も、同じ意味で読めるページへ整え直します。</p>
    </div>
  </section>

  <!-- 4. 3 Step -->
  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">How</span>
      <h2>3 ステップで、意味を整える。</h2>
      <ThreeStepFlow />
    </div>
  </section>

  <!-- 5. サービス一覧 -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h2>目的別に、6 つの入り口があります。</h2>
      <div class="grid grid--3 mt-4">
        {services.map((s) => (
          <a href={s.href} class="svc-card">
            <h3 class="svc-card__name">{s.label}</h3>
            <p class="svc-card__desc">{s.desc}</p>
            <span class="svc-card__more">詳細を見る →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. シミュレーション -->
  <section class="section section--alt" id="simulate">
    <div class="container">
      <span class="eyebrow">Simulation</span>
      <h2>商談化率が 50% 改善した場合の試算。</h2>
      <div class="grid grid--2 mt-4" style="align-items:start">
        <CompareSimulator />
        <div>
          <h3 style="margin-top:0">みんどり値で、改善点を数値化</h3>
          <p class="muted">既存ページの「意味の作り」を 100 点満点でスコア化します。must、must_not、典型例、反例の 4 軸での欠落をひと目で確認できます。</p>
          <div class="mt-3">
            <MindoriMeter value={42} label="現状の例" caption="must_not が空欄、典型例が不足" />
          </div>
          <div class="mt-2">
            <MindoriMeter value={86} label="改善後の例" caption="4 軸が揃い、AI が拾いやすい状態に" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. 根拠 -->
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">Background</span>
      <h2>研究と実装から生まれた、意味照合の技術です。</h2>
      <p>Meandle は、Jag Yamamoto / Jag Project が、BtoB Web マーケティングの実装と検証を 6 年以上積み重ねてきた中で体系化したものです。</p>
      <p>意味設計と検索文脈の整合に関する方法について、特許出願中の技術です。武蔵野美術大学では、非常勤講師として意味設計と表現の接続を実践的に指導しています。</p>
      <p class="muted" style="font-size:13px">※ 数値や事例は内部検証に基づくものを含みます。すべての事業・検索環境で同じ結果を保証するものではありません。</p>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">FAQ</span>
      <h2>よくある問い</h2>
      <FAQCard items={faqs} />
    </div>
  </section>

  <!-- 9. 最終CTA -->
  <section class="section section--dark">
    <div class="container container--narrow center">
      <span class="eyebrow" style="color:#ffc47e">Contact</span>
      <h2 style="color:#fff">まずは、既存URLを1つ送ってください。</h2>
      <p style="max-width:560px; margin:14px auto 28px">提案や売り込みはしません。事業のページの意味を整理する壁打ちとして使ってください。</p>
      <div class="flex-row" style="justify-content:center">
        <a href="/contact/" class="btn btn--lg">既存URLで診断する</a>
        <a href="/do-meandle/" class="btn btn--ghost-light btn--lg">do.meandle を見る</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:inline>
  .d-sp { display: none; }
  @media (max-width: 640px) { .d-sp { display: inline; } }
  .svc-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 22px 18px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  .svc-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    color: var(--ink);
  }
  .svc-card__name { margin: 0 0 4px; font-size: 17px; color: var(--accent-deep); }
  .svc-card__desc { margin: 0 0 14px; font-size: 14px; color: var(--muted); }
  .svc-card__more { font-size: 13px; color: var(--accent); font-weight: 700; }
</style>
