---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '広告費を増やす前に、AIと見込み客が拾える「売る意味」を整える｜Meandle';
const description = 'Meandleは、複雑なB2B商材の「誰に・何を・何ではないか」を意味仕様にし、既存Web、PR、求人へ実装する高単価B2Bソリューションです。既存URLから意味のズレを確認します。';
const ogTitle = '売る意味を整える、B2B意味設計｜Meandle';
const ogDescription = '正しい相手に、正しい理由で伝わるために。対象、価値、根拠、対象外条件を整え、既存ページへ実装します。';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://meandle.jp/#organization',
    name: 'ジャグプロジェクト合同会社',
    url: 'https://jagproject.com/',
    logo: 'https://meandle.jp/images/meandle-logo.png',
    brand: { '@type': 'Brand', name: 'Meandle' },
    founder: { '@type': 'Person', name: 'Jag Yamamoto' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://meandle.jp/#website',
    url: 'https://meandle.jp/',
    name: 'Meandle',
    publisher: { '@id': 'https://meandle.jp/#organization' },
    inLanguage: 'ja',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://meandle.jp/#webpage',
    url: 'https://meandle.jp/',
    name: title,
    description: description,
    isPartOf: { '@id': 'https://meandle.jp/#website' },
    about: { '@id': 'https://meandle.jp/#service' },
    inLanguage: 'ja',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': 'https://meandle.jp/#service',
    name: 'Meandle',
    serviceType: 'B2B意味設計',
    provider: { '@id': 'https://meandle.jp/#organization' },
    areaServed: 'JP',
    audience: {
      '@type': 'Audience',
      audienceType: '高単価・複雑B2Bの経営者、事業責任者、マーケティング責任者',
    },
    description: 'Meandleは、複雑なB2B商材の対象、価値、根拠、対象外条件を意味仕様にし、既存ページへ実装するB2Bソリューションです。',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Meandle サービス',
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'do.meandle 意味適合スプリント', url: 'https://meandle.jp/do-meandle/' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Meandle get lead', url: 'https://meandle.jp/get-lead/' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'do.meandle 伴走', url: 'https://meandle.jp/do-meandle/' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Meandle PR', url: 'https://meandle.jp/pr/' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Meandle recruit', url: 'https://meandle.jp/recruit/' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Meandle OEM', url: 'https://meandle.jp/oem/' } },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'MeandleはSEOやAIOの支援会社ですか。', acceptedAnswer: { '@type': 'Answer', text: 'いいえ。Meandleは、誰に、何を、なぜ提供し、何ではないかを仕様化するB2B意味設計です。検索やAI応答で扱われやすい構造も考慮しますが、順位計測、記事量産、一般的なサイト制作を主な提供価値にはしていません。' } },
      { '@type': 'Question', name: '50万円〜のスプリントでは、何が分かりますか。', acceptedAnswer: { '@type': 'Answer', text: '既存URL一つについて、現在の意味のズレ、対象／対象外質問、8項目の意味仕様、実装優先順位、検証条件を整理します。大規模な実装へ進む前に、直す価値と範囲を判断できます。' } },
      { '@type': 'Question', name: '50万円〜と1ページ200万円前後の違いは何ですか。', acceptedAnswer: { '@type': 'Answer', text: '50万円〜のスプリントは、何をどう伝えるべきかを定める段階です。1ページ200万円前後の実装では、その意味仕様を、見出し、本文、比較軸、根拠、FAQ、メタ情報まで一貫したページへ反映します。' } },
      { '@type': 'Question', name: '既存のSEO会社や計測ツールと併用できますか。', acceptedAnswer: { '@type': 'Answer', text: 'はい。既存施策のデータは、意味のズレを確認する材料になります。Meandleは、それらを置き換えるのではなく、観察結果を「何をどう伝えるか」という実装可能な仕様へ変えます。' } },
      { '@type': 'Question', name: 'AI検索での表示や商談成果は保証されますか。', acceptedAnswer: { '@type': 'Answer', text: 'いいえ。AI応答や検索環境は継続的に変わり、表示や商談成果を保証することはできません。開始時に確認条件を定め、結果と限界を分けて記録します。' } },
      { '@type': 'Question', name: 'まだAI検索に表示されていなくても依頼できますか。', acceptedAnswer: { '@type': 'Answer', text: 'はい。表示後の修正だけでなく、公開前の新商品、新技術、新規事業について、誤解されにくい対象、価値、根拠、対象外条件を先に設計できます。' } },
      { '@type': 'Question', name: '準備するものは何ですか。', acceptedAnswer: { '@type': 'Answer', text: '対象URL、営業資料、来てほしい顧客像、対象外としたい顧客や用途、実際の問い合わせ、価値を裏付ける事実をご用意ください。すべてがそろっていなくても、不足している情報を確認します。' } },
      { '@type': 'Question', name: '内容に機密情報が含まれます。', acceptedAnswer: { '@type': 'Answer', text: '送信前に、守秘が必要な旨をお知らせください。確認できる情報の範囲と進め方を先にご案内します。' } },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="/"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  structuredData={structuredData}
>
  <!-- Section 1: Hero (C: no image, motion + proof-panel + marquee) -->
  <section class="hero hero--split">
    <div class="hero__bg-grid" aria-hidden="true"></div>
    <div class="hero__bg-noise" aria-hidden="true"></div>
    <div class="container">
      <div class="hero__split">
        <div class="hero__left">
          <span class="eyebrow hero__eyebrow">複雑なB2B商材のための意味設計</span>
          <h1 class="hero-copy">広告費を増やす前に、<br/>AIと見込み客が拾える「売る意味」を整える。</h1>

          <p class="lead" style="margin-top:20px">
            高単価で説明の難しいB2B商材ほど、ページに情報があっても、「誰の、どの課題に、なぜ必要か」が伝わりきりません。
          </p>
          <p>
            Meandleは、複雑な商材の対象、価値、根拠、対象外条件を意味仕様にし、既存ページへ実装するB2Bソリューションです。
          </p>
          <p style="color:var(--muted); font-size:14px">
            AI検索への露出を増やす前に、見込み客が比較に使う意味を整えます。新しいサイトを一から作ることではなく、すでにある事業とページの間にあるズレを見つけることから始めます。
          </p>

          <p style="margin-top:16px"><strong>初回は、1商材・1URLの意味適合スプリント 50万円〜。</strong></p>

          <div class="hero__cta-group">
            <a href="/contact/" class="btn btn--primary">既存URLで導入適合性を確認する</a>
            <a href="#how-it-works" class="btn btn--secondary">進め方を見る</a>
          </div>
          <p style="font-size:13px; color:var(--muted); margin-top:12px">
            URLと、来てほしい顧客像をお送りください。50万円〜の意味適合スプリントの対象条件を確認します。
          </p>
        </div>

        <!-- Live Meaning-Design panel (3 tiers cycling) -->
        <aside class="proof-panel" aria-label="サービス3階段 ライブ表示">
          <div class="proof-panel__head">
            <span class="proof-panel__led"></span>
            <span class="proof-panel__label">MEANING&nbsp;DESIGN</span>
            <span class="proof-panel__timer"></span>
          </div>
          <div class="proof-stage">
            <div class="proof-slide is-active">
              <div class="proof-slide__type">① 意味適合スプリント</div>
              <div class="proof-slide__num proof-slide__num--label">50万円〜</div>
              <div class="proof-slide__name">do.meandle｜1商材・1URL</div>
              <div class="proof-slide__body">対象／対象外、8項目の意味仕様、実装方針・差分案、基準値と検証計画。<strong>実装は含みません。</strong></div>
              <div class="proof-slide__query">Read → Decide → Diff → Verify</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">② 1ページの意味実装</div>
              <div class="proof-slide__num proof-slide__num--label">200万円前後</div>
              <div class="proof-slide__name">Meandle get lead</div>
              <div class="proof-slide__body">情報設計、本文、比較軸、根拠、FAQ、メタ情報まで一貫させ、実装後の<strong>初回比較記録</strong>を残します。</div>
              <div class="proof-slide__query">One page · one meaning · one record</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">③ 回帰検証と更新</div>
              <div class="proof-slide__num proof-slide__num--label">月120万円〜</div>
              <div class="proof-slide__name">do.meandle 伴走</div>
              <div class="proof-slide__body">複数商材・複数ページに広げ、公開情報と対象条件の変化を確認して更新します。</div>
              <div class="proof-slide__query">Continuous meaning alignment</div>
            </div>
          </div>
          <div class="proof-panel__dots">
            <button class="proof-dot is-active" data-i="0" aria-label="スプリント"></button>
            <button class="proof-dot" data-i="1" aria-label="1ページ実装"></button>
            <button class="proof-dot" data-i="2" aria-label="伴走"></button>
          </div>
        </aside>
      </div>

      <div class="hero-marquee" aria-hidden="true">
        <div class="hero-marquee__track">
          <span class="hero-marquee__lead">◉ MEANDLE · MEANING DESIGN</span>
          <span>▸ 8-field spec · target / non-target</span>
          <span>▸ 対象・価値・根拠・対象外条件</span>
          <span>▸ patent pending</span>
          <span>▸ operated by Jag Yamamoto / Jag Project</span>
          <span>▸ do.meandle 50万〜 · get lead 200万〜 · 伴走 120万〜/月</span>
          <span class="hero-marquee__lead">◉ MEANDLE · MEANING DESIGN</span>
          <span>▸ 8-field spec · target / non-target</span>
          <span>▸ 対象・価値・根拠・対象外条件</span>
          <span>▸ patent pending</span>
          <span>▸ operated by Jag Yamamoto / Jag Project</span>
          <span>▸ do.meandle 50万〜 · get lead 200万〜 · 伴走 120万〜/月</span>
        </div>
      </div>

      <p style="text-align:center; font-size:12.5px; color:var(--muted); margin-top:20px">
        意味設計と検索文脈の整合に関する方法は、特許出願中です。MeandleはJag Yamamoto / Jag Projectが開発・監修しています。
      </p>
    </div>
  </section>

  <!-- Section 1.5: Reader router（読者3類型の入口。2026-08-14 Web OS診断 P1-1） -->
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">Where Are You Now</span>
      <h2>いま起きていることから、選んでください。</h2>
      <p>Meandleの入口は一つではありません。状況によって、先に読むべきページが違います。</p>

      <div class="grid grid--2 mt-4">
        <a href="/ai-search-optimization/" class="service-card">
          <h3>オウンドメディアはあるが、AI検索経由の引き合いにつながらない</h3>
          <p>AIO・LLMO・GEOという言葉の整理と、観測の次に何を決めるべきかから始めます。</p>
          <span>AI検索最適化とは →</span>
        </a>
        <a href="/get-lead/" class="service-card">
          <h3>問い合わせは来るが、商談にならない・対象外が多い</h3>
          <p>商談に必要な判断材料を、1ページへ一貫して実装するところから始めます。</p>
          <span>Meandle get lead を見る →</span>
        </a>
        <a href="/pr/" class="service-card">
          <h3>新しい事業・技術が、既存の言葉で誤解される</h3>
          <p>発表の前に、対象・価値・根拠・対象外条件をそろえるところから始めます。</p>
          <span>Meandle PR を見る →</span>
        </a>
        <a href="/do-meandle/" class="service-card">
          <h3>どこから直すべきか、まだ決められていない</h3>
          <p>既存URL一つを読み、何を直すべきかを判断する意味適合スプリントから始めます。</p>
          <span>do.meandle を見る →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 2: Problem -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">The Meaning Gap</span>
      <h2>見つからないことより、間違って見つかることがある。</h2>
      <p>
        商材名や機能がページに書かれていても、それだけで「誰に必要か」までは決まりません。AIと見込み客は、限られた説明からカテゴリ、用途、比較相手を推測します。
      </p>
      <p>
        その結果、本来とは違う相手に薦められる。一般的なサービスとして比較される。対象外の問い合わせに、営業が一から説明し直す。こうした意味のズレが、商談になる前に起きています。
      </p>

      <div class="grid grid--2 mt-4">
        <div class="card">
          <h3>何の会社かが広すぎる</h3>
          <p style="margin-bottom:0">「幅広く対応」「課題を解決」と書いても、どの場面で必要な会社かは伝わりません。</p>
        </div>
        <div class="card">
          <h3>誰向けかが抜けている</h3>
          <p style="margin-bottom:0">業種や企業規模だけでは、導入する人の状況や判断理由まで分かりません。</p>
        </div>
        <div class="card">
          <h3>対象外が書かれていない</h3>
          <p style="margin-bottom:0">できることだけを並べると、本来は合わない用途や相手まで候補に入ります。</p>
        </div>
        <div class="card">
          <h3>根拠と主張が離れている</h3>
          <p style="margin-bottom:0">実績や技術があっても、どの価値を支える根拠なのかが結ばれていなければ、比較材料になりません。</p>
        </div>
      </div>

      <p style="margin-top:24px">
        Meandleが整えるのは、文章の量ではありません。<strong>正しい相手が、正しい理由で検討するための意味</strong>です。
      </p>

      <div class="grid grid--2 mt-4">
        <div>
          <h3 style="color:var(--hero-orange)">この課題が大きい会社</h3>
          <ul>
            <li>一件の商談価値が高く、対象外問い合わせの損失が大きい</li>
            <li>新しいカテゴリ、専門技術、複合サービスを扱っている</li>
            <li>既存ページはあるが、営業、PR、採用で説明がそろっていない</li>
          </ul>
        </div>
        <div>
          <h3 style="color:var(--muted)">別の施策を先に行う会社</h3>
          <ul>
            <li>記事本数や広告露出だけを増やしたい</li>
            <li>順位やAI回答の保証を前提としている</li>
            <li>低価格で不特定多数への販売を優先している</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Process -->
  <section class="section" id="how-it-works">
    <div class="container container--narrow">
      <span class="eyebrow">How Meandle Works</span>
      <h2>文章を書く前に、意味を4段階で整えます。</h2>
      <p>
        Meandleは、既存URLを起点にします。現在の説明を読み、売上に必要な判断条件を定め、実装方針へ変えます。ページへ実装した後は、対象と対象外の両方で認識差を確かめます。
      </p>

      <p style="text-align:center; font-size:14px; margin-top:24px">
        既存ページを捨てずに、「読む・決める・実装方針にする・実装後に確かめる」の順で進めます。
      </p>

      <div class="algo-flow motion-flow">
        <svg viewBox="0 0 900 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="意味設計の4段階フロー">
          <defs>
            <marker id="arrow-idx" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="10" markerHeight="10" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#12242C"/></marker>
          </defs>
          <g font-family="var(--font-mono)" font-size="12" fill="#12242C">
            <text x="450" y="26" text-anchor="middle" font-size="13" font-weight="700" fill="#E98F22">Meandle · 4-step meaning flow</text>
            <g>
              <rect x="20"  y="60" width="180" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
              <text x="110" y="92" text-anchor="middle" font-size="13" font-weight="700">① 読む</text>
              <text x="110" y="118" text-anchor="middle" font-size="11" fill="#6F7777">既存URL/資料の意味確認</text>
              <line x1="200" y1="100" x2="213" y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow-idx)"/>

              <rect x="235" y="60" width="180" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
              <text x="325" y="92" text-anchor="middle" font-size="13" font-weight="700">② 決める</text>
              <text x="325" y="118" text-anchor="middle" font-size="11" fill="#6F7777">対象・価値・根拠・対象外</text>
              <line x1="415" y1="100" x2="428" y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow-idx)"/>

              <rect x="450" y="60" width="180" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
              <text x="540" y="92" text-anchor="middle" font-size="13" font-weight="700">③ 実装方針にする</text>
              <text x="540" y="118" text-anchor="middle" font-size="11" fill="#6F7777">見出し/本文/FAQ/メタ差分</text>
              <line x1="630" y1="100" x2="643" y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow-idx)"/>

              <rect x="665" y="60" width="215" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
              <text x="772" y="92" text-anchor="middle" font-size="13" font-weight="700">④ 実装後に確かめる</text>
              <text x="772" y="118" text-anchor="middle" font-size="11" fill="#6F7777">対象/対象外の質問で確認</text>
            </g>
            <text x="450" y="172" text-anchor="middle" font-size="11" fill="#6F7777">50万〜のスプリントは①〜③、200万〜のget leadで④を実装後初回比較として実行</text>
          </g>
        </svg>
      </div>

      <ol class="mt-4" style="font-size:15.5px; line-height:1.95">
        <li><strong>読む</strong>：既存URL、営業資料、実際の問い合わせから、現在伝わっている意味を確認します。</li>
        <li><strong>決める</strong>：誰に、どの場面で、何を、なぜ提供し、何は対象外かを定めます。</li>
        <li><strong>実装方針にする</strong>：title、見出し、本文、FAQ、メタ情報について、何を残し、何を変えるかを差分案にします。</li>
        <li><strong>実装後に確かめる</strong>：ページへの実装後、対象質問と対象外質問を分け、意図した説明との差を確認します。</li>
      </ol>

      <p style="margin-top:20px">
        50万円〜の初回スプリントは、1〜3の意味仕様と実装方針までです。ページへの実装と実装後の初回比較は、1ページ200万円前後のMeandle get leadで行います。担当者が変わっても、同じ説明を営業、PR、採用へ展開できる仕様を残します。
      </p>
    </div>
  </section>

  <!-- Section 4: Deliverables -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">What Remains</span>
