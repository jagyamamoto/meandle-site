---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'do.meandle｜既存B2Bページの意味適合スプリント 50万円〜｜Meandle';
const description = 'do.meandleは、複雑なB2B商材の既存URLを読み、対象・対象外・価値・根拠を意味仕様にする2週間の意味適合スプリントです。1商材・1URL、50万円〜。';
const ogTitle = '既存B2Bページの「売る意味」を整える｜do.meandle';
const ogDescription = '1商材・1URLから、対象／対象外、8項目の意味仕様、実装方針、検証計画を整理します。実装前に、何を変えるべきかを判断します。';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://meandle.jp/do-meandle/#webpage',
    url: 'https://meandle.jp/do-meandle/',
    name: title,
    description: description,
    inLanguage: 'ja',
    isPartOf: { '@id': 'https://meandle.jp/#website' },
    about: { '@id': 'https://meandle.jp/do-meandle/#service' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': 'https://meandle.jp/do-meandle/#service',
    name: 'do.meandle 意味適合スプリント',
    serviceType: 'B2B意味設計',
    url: 'https://meandle.jp/do-meandle/',
    description: '既存URLを読み、対象・対象外・価値・根拠を意味仕様にし、実装方針と検証計画を整理する高単価B2Bサービスです。',
    provider: { '@id': 'https://meandle.jp/#organization' },
    areaServed: 'JP',
    audience: {
      '@type': 'BusinessAudience',
      audienceType: '高単価で説明が複雑なB2B商材の経営者、事業責任者、営業・マーケティング責任者',
    },
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonical="/do-meandle/"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  structuredData={structuredData}
>
  <!-- Section 1: Hero (C) -->
  <section class="hero hero--split">
    <div class="hero__bg-grid" aria-hidden="true"></div>
    <div class="hero__bg-noise" aria-hidden="true"></div>
    <div class="container">
      <nav class="breadcrumb"><a href="/">ホーム</a>　/　do.meandle</nav>
      <div class="hero__split">
        <div class="hero__left">
          <span class="eyebrow hero__eyebrow">do.meandle / Meaning Fit Sprint</span>
          <h1 class="hero-copy">複雑なB2B商材の「売る意味」を、<br/>既存ページから整える。</h1>

          <p class="lead" style="margin-top:20px">
            広告費を増やす前に、AIと見込み客が拾える「売る意味」を整える。<br/>
            do.meandleは、既存の1 URLを読み、誰に、何を、なぜ提供し、何ではないかを意味仕様にする有償スプリントです。
          </p>
          <p>
            情報を増やす前に、現在のページが何として読まれているかを確認します。対象、価値、根拠、比較軸、対象外条件を整理し、次に実装すべきことを決めます。
          </p>

          <p style="margin-top:16px"><strong>1商材・既存URL 1本｜50万円〜</strong></p>

          <div class="hero__cta-group">
            <a href="/contact/" class="btn btn--primary">既存URLで導入適合性を確認する</a>
          </div>
          <p style="font-size:13px; color:var(--muted); margin-top:12px">
            送信内容を確認し、Meandleで扱うべき課題かをお返しします。<br/>
            検索順位、AI応答、商談成果を保証するサービスではありません。
          </p>
        </div>

        <aside class="proof-panel" aria-label="5 成果物 ライブ表示">
          <div class="proof-panel__head">
            <span class="proof-panel__led"></span>
            <span class="proof-panel__label">5&nbsp;DELIVERABLES</span>
            <span class="proof-panel__timer"></span>
          </div>
          <div class="proof-stage">
            <div class="proof-slide is-active">
              <div class="proof-slide__type">Deliverable 1</div>
              <div class="proof-slide__num proof-slide__num--label">意味診断</div>
              <div class="proof-slide__name">現状の意味診断</div>
              <div class="proof-slide__body">現在のページが、どの対象に、どの価値で、どの比較軸で読まれるかを整理します。</div>
              <div class="proof-slide__query">Read the existing URL</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">Deliverable 2</div>
              <div class="proof-slide__num proof-slide__num--label">対象／対象外</div>
              <div class="proof-slide__name">対象／対象外の質問設計</div>
              <div class="proof-slide__body">出てほしい質問と、対象にしない質問を分けます。問い合わせと営業の基準になります。</div>
              <div class="proof-slide__query">Target × non-target design</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">Deliverable 3</div>
              <div class="proof-slide__num proof-slide__num--label">8 項目仕様</div>
              <div class="proof-slide__name">8項目の意味仕様</div>
              <div class="proof-slide__body">役割、利用場面、比較対象、比較軸、価値、根拠、必須条件、対象外条件を一つにまとめます。</div>
              <div class="proof-slide__query">One spec, many touchpoints</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">Deliverable 4</div>
              <div class="proof-slide__num proof-slide__num--label">実装差分</div>
              <div class="proof-slide__name">実装方針と差分案</div>
              <div class="proof-slide__body">title、H1、見出し、本文、FAQ、メタ情報について、何を残し何を変えるかを優先順位とともに示します。</div>
              <div class="proof-slide__query">Prioritized implementation diff</div>
            </div>
            <div class="proof-slide">
              <div class="proof-slide__type">Deliverable 5</div>
              <div class="proof-slide__num proof-slide__num--label">検証計画</div>
              <div class="proof-slide__name">基準値と検証計画</div>
              <div class="proof-slide__body">実装前に何を確認し、実装後に何と比べるかを定めます。判断できること・できないことを分けます。</div>
              <div class="proof-slide__query">What we can and cannot verify</div>
            </div>
          </div>
          <div class="proof-panel__dots">
            <button class="proof-dot is-active" data-i="0" aria-label="1"></button>
            <button class="proof-dot" data-i="1" aria-label="2"></button>
            <button class="proof-dot" data-i="2" aria-label="3"></button>
            <button class="proof-dot" data-i="3" aria-label="4"></button>
            <button class="proof-dot" data-i="4" aria-label="5"></button>
          </div>
        </aside>
      </div>

      <div class="hero-marquee" aria-hidden="true">
        <div class="hero-marquee__track">
          <span class="hero-marquee__lead">◉ MEANING FIT SPRINT</span>
          <span>▸ 1 商材・1URL · 50万〜</span>
          <span>▸ 5 deliverables · no implementation included</span>
          <span>▸ 8-field spec · target/non-target</span>
          <span>▸ patent pending</span>
          <span class="hero-marquee__lead">◉ MEANING FIT SPRINT</span>
          <span>▸ 1 商材・1URL · 50万〜</span>
          <span>▸ 5 deliverables · no implementation included</span>
          <span>▸ 8-field spec · target/non-target</span>
          <span>▸ patent pending</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Problem -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">Before Implementation</span>
      <h2>ページを直す前に、「何が伝わっていないか」を決めます。</h2>
      <p>高単価で説明が複雑な商材は、機能や実績を増やしても、比較の理由がそろうとは限りません。</p>
      <p>その結果、一般的なサービスとして扱われる。対象外の問い合わせが来る。営業、PR、Webで説明が割れる。こうしたズレは、制作前に見つける必要があります。</p>

      <div class="grid grid--2 mt-4">
        <div class="card"><h3>誰向けかが、役職や業種だけで止まっている</h3><p style="margin-bottom:0">導入する場面、判断する人、解決したい状況まで書かれていなければ、適合する相手は判断できません。</p></div>
        <div class="card"><h3>価値と根拠が、別々に置かれている</h3><p style="margin-bottom:0">実績や技術があっても、どの価値を支えるものかが結ばれていなければ、比較の材料になりません。</p></div>
        <div class="card"><h3>比較される相手が決まっていない</h3><p style="margin-bottom:0">何と比べ、どの条件で選ばれるべきかが曖昧だと、価格だけで比べられやすくなります。</p></div>
        <div class="card"><h3>対象外条件が、ページに存在しない</h3><p style="margin-bottom:0">できることだけを並べると、本来は合わない顧客や用途まで候補に入ります。</p></div>
      </div>

      <p style="margin-top:20px">do.meandleは、文章を先に書き換える仕事ではありません。<strong>正しい相手が、正しい理由で検討できる条件を定める仕事</strong>です。</p>
    </div>
  </section>

  <!-- Section 3: Scope -->
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">What 50万円〜 Covers</span>
      <h2>50万円〜で行うのは、実装ではなく「実装判断」の設計です。</h2>
      <p>対象は、1商材・既存URL 1本です。現在のページを読み、誰へ何を伝えるべきかを整理し、実装に進む場合の優先順位と比較方法を残します。</p>

      <div class="grid grid--2 mt-4">
        <div class="card"><h3>1. 既存URLの読解</h3><p style="margin-bottom:0">現在のページが、どの対象に、どの価値で、どの比較軸で読まれるかを整理します。</p></div>
        <div class="card"><h3>2. 対象／対象外の設計</h3><p style="margin-bottom:0">来てほしい顧客の質問と、本来は対象にしない顧客・用途の質問を分けます。</p></div>
        <div class="card"><h3>3. 8項目の意味仕様</h3><p style="margin-bottom:0">役割、利用場面、比較対象、比較軸、価値、根拠、必須条件、対象外条件を一つの仕様にまとめます。</p></div>
        <div class="card"><h3>4. 実装方針と差分案</h3><p style="margin-bottom:0">title、H1、見出し、本文、FAQ、メタ情報などについて、何を残し、何を変えるかを優先順位とともに示します。</p></div>
        <div class="card"><h3>5. 基準値と検証計画</h3><p style="margin-bottom:0">実装前に何を確認し、実装後に何と比べるかを定めます。確認できることと、確認できないことを分けて記録します。</p></div>
      </div>

      <div class="callout-note">
        <strong>含まれないこと：</strong>ページの実装、記事の量産、広告運用、順位計測だけの代行、AI応答や商談成果の保証は含みません。
      </div>
    </div>
  </section>

  <!-- Section 4: Process -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">Two-Week Sprint</span>
      <h2>既存ページを捨てずに、読む・決める・比べる・渡す。</h2>
      <p>標準的には2週間で進めます。公開情報と提供資料を読み、事実確認を行い、実装に進むための判断材料をまとめます。開始時期は、確認事項と稼働状況により個別にご案内します。</p>

      <div class="algo-flow motion-flow">
        <svg viewBox="0 0 900 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="スプリント 4 段階">
          <defs><marker id="arrow-dm" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="10" markerHeight="10" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#12242C"/></marker></defs>
          <g font-family="var(--font-mono)" font-size="12" fill="#12242C">
            <text x="450" y="26" text-anchor="middle" font-size="13" font-weight="700" fill="#E98F22">2-week Sprint · Read → Decide → Diff → Handoff</text>
            <rect x="20"  y="60" width="180" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
            <text x="110" y="92"  text-anchor="middle" font-size="13" font-weight="700">① 読む</text>
            <text x="110" y="118" text-anchor="middle" font-size="11" fill="#6F7777">URL/資料/問い合わせ</text>
            <line x1="200" y1="100" x2="213" y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow-dm)"/>
            <rect x="235" y="60" width="180" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
            <text x="325" y="92"  text-anchor="middle" font-size="13" font-weight="700">② 決める</text>
            <text x="325" y="118" text-anchor="middle" font-size="11" fill="#6F7777">対象・価値・根拠・対象外</text>
            <line x1="415" y1="100" x2="428" y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow-dm)"/>
            <rect x="450" y="60" width="180" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
            <text x="540" y="92"  text-anchor="middle" font-size="13" font-weight="700">③ 比べる</text>
            <text x="540" y="118" text-anchor="middle" font-size="11" fill="#6F7777">現行 vs 仕様 差分整理</text>
            <line x1="630" y1="100" x2="643" y2="100" stroke="#12242C" stroke-width="1.5" marker-end="url(#arrow-dm)"/>
            <rect x="665" y="60" width="215" height="80" rx="8" fill="#FFF9ED" stroke="#12242C" stroke-width="1.5"/>
            <text x="772" y="92"  text-anchor="middle" font-size="13" font-weight="700">④ 渡す</text>
            <text x="772" y="118" text-anchor="middle" font-size="11" fill="#6F7777">仕様＋差分案＋検証計画</text>
          </g>
        </svg>
      </div>

      <ol class="mt-4" style="font-size:15.5px; line-height:1.95">
        <li><strong>読む</strong>：既存URL、営業資料、実際の問い合わせから、現在伝わっている意味を確認します。</li>
        <li><strong>決める</strong>：誰に、どの場面で、何を、なぜ提供し、何は対象外かを定めます。</li>
        <li><strong>比べる</strong>：現在のページと意味仕様を照らし、実装する場合の優先順位と差分を整理します。</li>
        <li><strong>渡す</strong>：8項目の意味仕様、差分案、基準値、検証計画を、次の意思決定に使える形で共有します。</li>
      </ol>
    </div>
  </section>

  <!-- Section 5: Deliverable Detail -->
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">The Meaning Specification</span>
      <h2>納品するのは、担当者が変わっても使える判断の仕様です。</h2>
      <p>施策の感想や一般論だけでは、次の制作や営業説明に引き継げません。</p>
      <p>do.meandleでは、なぜその表現にするのか、誰を対象外にするのか、何を根拠にするのかを、更新できる仕様として残します。</p>

      <div class="table-wrap mt-3">
        <table class="compare-table">
          <thead><tr><th style="width:20%">項目</th><th>決めること</th></tr></thead>
          <tbody>
            <tr><td>役割</td><td>その商材は、顧客にとって何の役割を担うか</td></tr>
            <tr><td>利用場面</td><td>どの状況で検討されるか</td></tr>
            <tr><td>比較対象</td><td>顧客が何と比べるか</td></tr>
            <tr><td>比較軸</td><td>どの条件で選ぶべきか</td></tr>
            <tr><td>価値</td><td>導入後に得たい状態は何か</td></tr>
            <tr><td>根拠</td><td>価値を支える事実、条件、実績は何か</td></tr>
            <tr><td>必須条件</td><td>対象顧客に必要な前提は何か</td></tr>
            <tr><td>対象外条件</td><td>どの顧客・用途・期待には適さないか</td></tr>
          </tbody>
        </table>
      </div>

      <p style="margin-top:16px">この仕様は、ページ実装だけでなく、営業資料、PR、採用、外部パートナーとの説明をそろえる基準になります。</p>
    </div>
  </section>

  <!-- Section 6: What Happens Next -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">Decide the Next Step</span>
      <h2>意味を定めた後に、実装するか、継続するかを決めます。</h2>
      <p>スプリントの目的は、すべての案件を制作へ進めることではありません。実装の価値と範囲が確認できた場合にだけ、次の段階をご提案します。</p>

      <div class="price-card mt-4">
        <div class="price-label">Step 1｜do.meandle 意味適合スプリント</div>
        <div class="price">¥500,000<span class="price-unit">〜</span></div>
        <p style="margin-bottom:0">1商材・既存URL 1本を読み、対象／対象外、8項目の意味仕様、実装方針・差分案、基準値と検証計画を整理します。</p>
      </div>
      <div class="price-card">
        <div class="price-label">Step 2｜Meandle get lead</div>
        <div class="price">¥2,000,000<span class="price-unit"> 前後 / ページ</span></div>
        <p style="margin-bottom:0">スプリントで定めた意味仕様を、1ページの情報設計、本文、比較軸、根拠、FAQ、メタ情報へ実装し、初回比較まで行います。</p>
      </div>
      <div class="price-card">
        <div class="price-label">Step 3｜do.meandle 伴走</div>
        <div class="price">¥1,200,000<span class="price-unit"> / 月〜</span></div>
        <p style="margin-bottom:0">複数ページや更新をまたぎ、継続的な比較検証と更新を行います。新しい事実、商材、顧客像の変化に合わせ、意味仕様も見直します。</p>
      </div>

      <div class="callout-note">
        価格は下限または目安です。対象商材、事実確認、実装範囲、継続範囲により個別に設計します。表示、応答、商談成果を保証するものではありません。
      </div>

      <p style="margin-top:12px"><a href="/get-lead/">1ページ実装の詳細を見る →</a></p>
    </div>
  </section>

  <!-- Section 7: Fit -->
  <section class="section">
    <div class="container container--narrow">
      <span class="eyebrow">Fit Before Scale</span>
      <h2>do.meandleが向く会社と、別の施策を先に行う会社があります。</h2>

      <div class="grid grid--2 mt-4">
        <div>
          <h3 style="color:var(--hero-orange)">向いている会社</h3>
          <ul>
            <li>高単価で、説明が複雑なB2B商材を扱っている</li>
            <li>対象顧客が狭く、対象外の問い合わせに営業工数を使っている</li>
            <li>新カテゴリ、専門技術、複合サービスを扱っている</li>
            <li>既存サイトと営業資料があり、事実確認に協力できる</li>
            <li>90日以内に見直したい商材とURLを一つに絞れる</li>
            <li>事業責任者、営業責任者、マーケティング責任者のいずれかが判断に参加できる</li>
          </ul>
        </div>
        <div>
          <h3 style="color:var(--muted)">向いていない会社</h3>
          <ul>
            <li>記事の本数だけを増やしたい</li>
            <li>順位や言及数の計測だけを求めている</li>
            <li>実装を伴わない低価格のツールだけを探している</li>
            <li>検索順位、AI応答、商談成果の保証を前提としている</li>
            <li>誰を顧客にしないかを決められない</li>
            <li>1商材・1URL、50万円〜の有償スプリントから始める予算がない</li>
          </ul>
        </div>
      </div>

      <p style="margin-top:20px">適さない場合は、広告、サイト制作、計測、営業体制など、別の施策を先に行う方が合理的です。対象条件を確認し、適合する場合に有償スプリントの進め方をご案内します。</p>
    </div>
  </section>

  <!-- Section 8: FAQ -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">FAQ</span>
      <h2>ご相談前によくある確認</h2>
      <details class="faq-item">
